+function Wait-AuditOwnedBuild($Owner, $Record, [long]$StartedMs, [scriptblock]$MeasureOutput, [scriptblock]$ObserveResidual=$null) {
+    $observedResidual=$false
     while ($true) {
         $sample = Get-AuditOwnedSnapshot $Owner $StartedMs
         Assert-AuditOwnedBudget $sample $Record $StartedMs $MeasureOutput
+        if ($sample.RootExited -and $sample.Active -gt 0 -and !$observedResidual -and $ObserveResidual) {
+            $observedResidual=$true
+            & $ObserveResidual
+            # Observation costs consume the existing drain/global deadlines.
+            # A callback can never turn the old nonzero snapshot into closure.
+            Assert-AuditOwnedBudget $sample $Record $StartedMs $MeasureOutput
+        }
         if ($sample.RootExited -and $sample.Active -eq 0) {
             $Record.RootExitCode = $sample.RootExitCode
             $Record.JobActiveAtClose = 0
diff --git a/audit/test_diagnostics.ps1 b/audit/test_diagnostics.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..a119fa149931e310ce4195d0ba6dfedc36c344ec
--- /dev/null
+++ b/audit/test_diagnostics.ps1
@@ -0,0 +1,98 @@
+# Pure mocks, plus one small managed file-hash check. No native load or process.
+$ErrorActionPreference='Stop'
+. (Join-Path $PSScriptRoot 'supervision.ps1')
+. (Join-Path $PSScriptRoot 'diagnostics.ps1')
+$script:checks=0
+function Check([bool]$Value,[string]$Message) { if (!$Value) { throw $Message }; $script:checks++ }
+function Get-AuditMonotonicMs { $script:now }
+function Wait-AuditPoll([int]$Milliseconds) { $script:now+=$Milliseconds }
+$script:now=0L
+$budget=[ordered]@{StartedMs=0L;Bytes=0L}
+$path=Join-Path $PSScriptRoot 'diagnostics.ps1'
+$real=Get-AuditImageFileWitness $path $budget
+Check ($real.SHA256 -ceq (Get-FileHash -LiteralPath $path).Hash.ToLowerInvariant()) 'Managed streaming hash matches file'
+Check ($real.Bytes -eq (Get-Item -LiteralPath $path).Length -and $budget.Bytes -eq $real.Bytes) 'Hash accounts exact small source bytes'
+$budget=[ordered]@{StartedMs=0L;Bytes=128MB};$caught=$null
+try { Get-AuditImageFileWitness $path $budget } catch { $caught=$_.Exception.Message }
+Check ($caught -match 'byte budget') 'Total image byte budget refuses before reading another image'
+$script:now=1000L;$budget=[ordered]@{StartedMs=0L;Bytes=0L};$caught=$null
+try { Get-AuditImageFileWitness $path $budget } catch { $caught=$_.Exception.Message }
+Check ($caught -match 'time/byte budget') 'Streaming hash includes elapsed observation time'
+
+function Get-AuditOriginalJobMembers($Owner) {
+    $script:captures++
+    if ($script:captureFailure) { throw 'Native observation unavailable' }
+    $script:now+=$script:captureCost
+    $script:observation
+}
+function Get-AuditImageFileWitness([string]$Path,$Budget) {
+    $script:hashes++;$script:now+=$script:hashCost
+    if ($script:hashFailure) { throw 'Bounded image file unavailable' }
+    $Budget.Bytes+=10
+    [ordered]@{SHA256=('a'*64);Bytes=10;Scope='ImageFileBytesUnderReadGuard'}
+}
+function Fixture {
+    $script:now=0L;$script:captures=0;$script:hashes=0;$script:captureFailure=$false;$script:hashFailure=$false
+    $script:captureCost=0L;$script:hashCost=0L
+    $script:member=[pscustomobject]@{PID=7;Image='C:\mock\unknown.exe';CreatedUtc='2026-10-12T06:00:00.0000000Z';
+        ParentPID=6;InOriginalJob=$true;Error=$null;ParentError=$null}
+    $script:observation=[pscustomobject]@{CapturedUtc='2026-10-12T06:00:01.0000000Z';AssignedCount=1;ListedCount=1;Members=@($script:member)}
+    [ordered]@{PeakObservedOutputBytes=0L;JobActiveAtClose=$null;RootExitCode=$null;Success=$false}
+}
+$record=Fixture
+Save-AuditResidualObservation ([object]::new()) $record
+Check ($record.ResidualDiagnostic.Complete -and $script:hashes -eq 1) 'Unknown named original member may be observed without being classified'
+Check (!$record.ResidualDiagnostic.AcceptanceGranted -and !$record.ResidualDiagnostic.ClassifierApplicable -and !$record.Success) 'Diagnostics grant no acceptance'
+Check ($record.ResidualDiagnostic.Images[0].ParentPID -eq 6 -and $record.ResidualDiagnostic.Images[0].InOriginalJob) 'Original membership and kernel ParentPID retained'
+
+foreach ($property in @('InOriginalJob','CreatedUtc','Image','ParentPID')) {
+    $record=Fixture;$script:member.$property=$null
+    Save-AuditResidualObservation ([object]::new()) $record
+    Check (!$record.ResidualDiagnostic.Complete -and $script:hashes -eq 0) 'Incomplete identity never hashes/adopts an unrelated path'
+}
+foreach ($property in @('Error','ParentError')) {
+    $record=Fixture;$script:member.$property='unavailable'
+    Save-AuditResidualObservation ([object]::new()) $record
+    Check (!$record.ResidualDiagnostic.Complete -and $script:hashes -eq 0) 'Native identity error remains diagnostic failure'
+}
+$record=Fixture;$script:captureFailure=$true
+Save-AuditResidualObservation ([object]::new()) $record
+Check ($record.ResidualDiagnostic.Error -match 'unavailable' -and !$record.ResidualDiagnostic.Complete) 'Native capture error is preserved'
+$record=Fixture;$script:hashFailure=$true
+Save-AuditResidualObservation ([object]::new()) $record
+Check ($record.ResidualDiagnostic.Images[0].Error -match 'unavailable' -and !$record.ResidualDiagnostic.Complete) 'Image hash failure stays unknown'
+$record=Fixture;$script:observation.AssignedCount=2
+Save-AuditResidualObservation ([object]::new()) $record
+Check ($record.ResidualDiagnostic.Error -match 'Incomplete bounded' -and $script:hashes -eq 0) 'Truncated job list refuses image processing'
+$record=Fixture;$script:observation.Members=@($script:member)*65;$script:observation.AssignedCount=65;$script:observation.ListedCount=65
+Save-AuditResidualObservation ([object]::new()) $record
+Check ($record.ResidualDiagnostic.Error -match 'bounded' -and $script:hashes -eq 0) 'More than 64 members refused'
+foreach ($cost in @(1000,1001)) {
+    $record=Fixture;$script:hashCost=$cost
+    Save-AuditResidualObservation ([object]::new()) $record
+    Check (!$record.ResidualDiagnostic.Complete -and $record.ResidualDiagnostic.Error -match 'deadline') 'Late diagnostic never claims complete'
+}
+$record=Fixture;$script:captureCost=1000
+Save-AuditResidualObservation ([object]::new()) $record
+Check (!$record.ResidualDiagnostic.Complete -and $script:hashes -eq 0) 'Native capture time belongs to diagnostic budget'
+
+# Exercise the actual wait callback: exactly once, fresh zero observation only,
+# and no extension of the original 2 s drain when observation is slow.
+function Get-AuditOwnedSnapshot($Owner,[long]$StartedMs) {
+    $script:polls++
+    [pscustomobject]@{ElapsedMs=$script:now-$StartedMs;CompletedMs=$script:now-$StartedMs;
+        RootExited=$true;Active=$(if($script:polls -le 2){1}else{0});RootExitCode=0}
+}
+$record=Fixture;$script:polls=0;$script:callbacks=0
+Wait-AuditOwnedBuild ([object]::new()) $record 0 {0L} {$script:callbacks++;Save-AuditResidualObservation $null $record}
+Check ($script:callbacks -eq 1 -and $script:polls -eq 3 -and $record.JobActiveAtClose -eq 0) 'Single diagnostic then fresh owned zero observation'
+$record=Fixture;$script:polls=0;$caught=$null
+try { Wait-AuditOwnedBuild ([object]::new()) $record 0 {0L} {$script:now+=2000} } catch { $caught=$_.Exception.Message }
+Check ($caught -match 'drain deadline' -and $null -eq $record.JobActiveAtClose -and $record.RootExitObservedMs -eq 0) 'Diagnostic time cannot extend drain or accept stale snapshot'
+
+$launcher=[IO.File]::ReadAllText((Join-Path $PSScriptRoot 'build.ps1'))
+Check ($launcher.IndexOf('$lease = Enter-IW7ResourceLease') -lt $launcher.IndexOf('Add-Type -Path $planData.members_source')) 'Observer native load follows full admission'
+Check ($launcher.IndexOf('if (-not $Execute)') -lt $launcher.IndexOf('Add-Type -Path $planData.members_source')) 'Plan does not load native observer'
+$diagnostics=[IO.File]::ReadAllText((Join-Path $PSScriptRoot 'diagnostics.ps1'))
+Check ($diagnostics -notmatch '\.Stop\(|\.Kill\(|\.Dispose\(\).*Owner|Stop-Process|Exit-IW7ResourceLease') 'Diagnostic source has no process/lease mutation'
+Write-Output "Residual diagnostics: $script:checks checks passed; no native execution."
