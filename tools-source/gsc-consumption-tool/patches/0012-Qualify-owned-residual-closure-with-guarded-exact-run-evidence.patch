+}
+
+function Complete-AuditBuildEvidence($Owner,$Record,[long]$StartedMs,$Plan,$Context,[scriptblock]$MeasureOutput,[bool]$Residual) {
+    $state=@{Guards=[Collections.Generic.List[object]]::new();Files=@{};Bytes=0L}
+    $proof=[ordered]@{Mode=$(if($Residual){'OriginalJobPinnedResidual'}else{'OriginalJobNaturalClosure'});Residual=$Residual;CompletionVerified=$false;
+        Identity=$null;First=$null;Final=$null;StopRequested=$false;ClosureVerified=$false;AcceptanceGranted=$false;Error=$null}
+    $Record.QualifiedClosure=$proof
+    $check={ Assert-AuditClosureClock $Record $StartedMs }
+    $reader={param($Path,$Maximum,$AsJson) Open-AuditCompletionFile $Path $Maximum $AsJson $state $check}
+    try {
+        if ($Residual) { $proof.First=Get-AuditClosureCapture $Owner $StartedMs $Record $MeasureOutput }
+        $receipt=& $reader (Join-Path $Plan.output 'build-receipt.json') 8MB $true
+        $verified=Assert-AuditCompletionReceipt $receipt.Json $Plan $Context $reader $check
+        $proof.ReceiptSHA256=$receipt.SHA256;$proof.CompletionVerified=$true
+        $Record.CompletionEvidence=$verified
+        $compiler=& $reader $verified.CompilerImage 64MB $false
+        if ($compiler.SHA256 -cne 'fe251ef50a1545b1b0835ee17b1e785459712b38d79e45b5c1d3d28970a36619') { throw 'Configured compiler file drift' }
+        & $check
+        if ($Residual) {
+            $telemetry=& $reader (Join-Path ([IO.Path]::GetDirectoryName($verified.CompilerImage)) 'vctip.exe') 64MB $false
+            $proof.First.ImageFile=$telemetry
+            $proof.Final=Get-AuditClosureCapture $Owner $StartedMs $Record $MeasureOutput
+            $proof.Final.ImageFile=$telemetry
+            $proof.Identity=Get-AuditPinnedResidualIdentity $Context.OriginalIdentity $compiler $proof.First $proof.Final
+            & $check
+            # Still held: compiler/vctip, receipt and every checked artifact guard.
+            $proof.StopRequested=$true;$Record.StopOriginalJobRequested=$true
+            $Owner.Stop()
+            & $check
+        }
+        while ($true) {
+            $sample=Get-AuditOwnedSnapshot $Owner $StartedMs
+            Assert-AuditOwnedBudget $sample $Record $StartedMs $MeasureOutput
+            if (!$sample.RootExited -or $sample.RootExitCode -ne 0) { throw 'Original root success changed during closure' }
+            $proof.CloseObservation=$sample
+            if ($sample.Active -eq 0) { break }
+            if (!$Residual) { throw 'Member appeared after normal zero closure' }
+            Wait-AuditPoll 25
+        }
+        & $check
+        $proof.ClosureVerified=$true;$proof.AcceptanceGranted=$true
+    } catch { $proof.Error=$_.Exception.Message;throw }
+    finally { $proof.GuardedBytes=$state.Bytes;Close-AuditCompletionFiles $state }
+}
