diff --git a/audit/make_reference_profile.py b/audit/make_reference_profile.py
new file mode 100644
index 0000000000000000000000000000000000000000..235df4ad37d88b0433fecc4636751bccb11d1285
--- /dev/null
+++ b/audit/make_reference_profile.py
@@ -0,0 +1,106 @@
+"""Reproduce the reviewed IW7 encoding profile from local source; no native execution."""
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[1]
+BASE = '3300e430d1efef00e54c66a8bd416e18a2a9882a'
+
+
+def make_profile(root=ROOT):
+    def git(*args):
+        return subprocess.check_output(['git', '-C', str(root), *args], text=True).strip()
+
+    groups = {}
+
+    def group(kind, size, names):
+        for name in names.split():
+            name = 'OP_' + name
+            if name in groups:
+                raise ValueError('Duplicate policy opcode: ' + name)
+            groups[name] = (kind, size)
+
+    group('plain', 1, '''CastFieldObject plus GetGameRef GetThisthread greater shift_right dec bit_or
+        equality ClearLocalVariableFieldCached0 notify PreScriptCall GetUndefined SetLocalVariableFieldCached0
+        GetLevel size AddArray endon shift_left EvalLocalArrayRefCached0 Return SafeSetVariableFieldCached0
+        GetSelfObject GetGame EvalArray GetSelf End less_equal EvalLocalVariableCached0 EvalLocalVariableCached1
+        EvalLocalVariableCached2 EvalLocalVariableCached3 EvalLocalVariableCached4 EvalLocalVariableCached5
+        checkclearparams waittillmatch2 minus greater_equal vector ClearArray DecTop CastBool EvalArrayRef GetZero
+        wait waittill GetAnimObject mod clearparams EmptyArray BoolComplement less BoolNot waittillFrameEnd
+        GetLevelObject inc GetAnim SetVariableField divide multiply EvalLocalVariableRefCached0 bit_and
+        voidCodepos inequality bit_ex_or''')
+    group('scalar', 2, 'GetByte GetNegByte waittillmatch')
+    group('scalar', 3, 'GetUnsignedShort GetNegUnsignedShort')
+    group('scalar', 5, 'GetInteger GetFloat')
+    group('scalar', 13, 'GetVector')
+    group('slot', 2, '''ClearLocalVariableFieldCached SetLocalVariableFieldCached RemoveLocalVariables
+        EvalLocalVariableRefCached EvalLocalArrayRefCached SafeSetVariableFieldCached EvalLocalVariableCached
+        SafeSetWaittillVariableFieldCached EvalLocalVariableObjectCached EvalLocalArrayCached
+        CreateLocalVariable EvalNewLocalArrayRefCached0 SafeCreateVariableFieldCached SetNewLocalVariableFieldCached0''')
+    group('field', 5, '''EvalSelfFieldVariable SetLevelFieldVariableField ClearFieldVariable EvalFieldVariable
+        EvalFieldVariableRef EvalLevelFieldVariable SetAnimFieldVariableField SetSelfFieldVariableField
+        EvalAnimFieldVariableRef EvalLevelFieldVariableRef EvalAnimFieldVariable EvalSelfFieldVariableRef''')
+    group('string', 5, 'GetString GetIString')
+    group('animation', 9, 'GetAnimation')
+    group('animtree', 2, 'GetAnimTree')
+    group('pointer', 1, 'ScriptMethodCallPointer ScriptFunctionCallPointer')
+    group('pointer', 2, '''CallBuiltinPointer CallBuiltinMethodPointer ScriptThreadCallPointer
+        ScriptChildThreadCallPointer ScriptMethodThreadCallPointer ScriptMethodChildThreadCallPointer''')
+    group('local_address', 4, 'GetLocalFunction')
+    group('local_call', 4, 'ScriptLocalFunctionCall2 ScriptLocalFunctionCall ScriptLocalMethodCall')
+    group('local_call', 5, '''ScriptLocalThreadCall ScriptLocalChildThreadCall
+        ScriptLocalMethodThreadCall ScriptLocalMethodChildThreadCall''')
+    group('external_address', 4, 'GetFarFunction')
+    group('external_call', 4, 'ScriptFarFunctionCall2 ScriptFarFunctionCall ScriptFarMethodCall')
+    group('external_call', 5, '''ScriptFarThreadCall ScriptFarChildThreadCall
+        ScriptFarMethodThreadCall ScriptFarMethodChildThreadCall''')
+    group('builtin_function_address', 3, 'GetBuiltinFunction')
+    group('builtin_method_address', 3, 'GetBuiltinMethod')
+    group('builtin_function', 3, 'CallBuiltin0 CallBuiltin1 CallBuiltin2 CallBuiltin3 CallBuiltin4 CallBuiltin5')
+    group('builtin_method', 3, '''CallBuiltinMethod0 CallBuiltinMethod1 CallBuiltinMethod2
+        CallBuiltinMethod3 CallBuiltinMethod4 CallBuiltinMethod5''')
+    group('builtin_function', 4, 'CallBuiltin')
+    group('builtin_method', 4, 'CallBuiltinMethod')
+    group('branch_i16', 3, 'JumpOnFalse JumpOnTrue JumpOnFalseExpr JumpOnTrueExpr')
+    group('branch_back_u16', 3, 'jumpback')
+    group('branch_i32', 5, 'jump')
+    group('switch', 5, 'switch')
+    group('switch_table', 3, 'endswitch')
+    # Registered upstream, but context::opcode_size deliberately throws. Do not
+    # silently give these the size-one interpretation from the instruction switch.
+    group('unsupported_size', None, 'ClearVariableField EvalNewLocalVariableRefCached0')
+    code_path = 'src/gsc/engine/iw7_code.cpp'
+    code = (root / code_path).read_text(encoding='utf-8')
+    entries = [(int(raw, 16), name) for raw, name in re.findall(
+        r'\{\s*(0x[0-9A-Fa-f]+),\s*opcode::(OP_\w+)\s*\}', code)]
+    if len(entries) != 153 or set(name for _, name in entries) != set(groups):
+        raise ValueError('IW7 opcode taxonomy is not exhaustive')
+    files = sorted(p.relative_to(root).as_posix() for p in (root / 'src/gsc/engine').glob('iw7*'))
+    files += ['include/xsk/gsc/engine/iw7.hpp', 'include/xsk/gsc/common/assembly.hpp', 'src/gsc/context.cpp']
+    records = [{'path': path, 'sha256': hashlib.sha256((root / path).read_bytes()).hexdigest()}
+               for path in sorted(files)]
+    provenance = []
+    for path in files:
+        if path.startswith('src/gsc/engine/iw7') or path.endswith('engine/iw7.hpp'):
+            blob = git('rev-parse', BASE + ':' + path)
+            current = git('hash-object', str(root / path))
+            if blob != current:
+                raise ValueError('Community table changed from the pinned upstream baseline: ' + path)
+            provenance.append({'path': path, 'base_blob': blob,
+                               'last_change': git('log', '-1', '--format=%H', BASE, '--', path)})
+    return {'schema': 'iw7.gsc-reference-profile/1', 'engine': 'iw7-pc-server',
+            'features': ['str4', 'tok4', 'offs9'], 'max_string_id': 0x13FCC,
+            'upstream_url': 'https://github.com/xensik/gsc-tool', 'upstream_base': BASE,
+            'table_authority': 'community-source-only', 'retail_runtime_attested': False,
+            'counts': {'opcodes': 153, 'functions': 806, 'methods': 1483, 'tokens': 13220},
+            'table_files': records,
+            'tables_sha256': hashlib.sha256(json.dumps(records, sort_keys=True, separators=(',', ':')).encode()).hexdigest(),
+            'table_provenance': provenance,
+            'opcodes': [{'id': raw, 'name': name, 'kind': groups[name][0], 'bytes': groups[name][1]}
+                        for raw, name in entries]}
+
+
+if __name__ == '__main__':
+    print(json.dumps(make_profile(), indent=2))
