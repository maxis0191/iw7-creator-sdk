Subject: [PATCH 3/9] fix(audit): read scalars without alignment or aliasing UB


diff --git a/audit/reader_tests.cpp b/audit/reader_tests.cpp
index 8fcf3d58d2cbe26d2b42913681e99e35121ee254..b8dc5e0cc5c4b7415f1fad779099a3e2d49cd9d5 100644
--- a/audit/reader_tests.cpp
+++ b/audit/reader_tests.cpp
@@ -2,6 +2,7 @@
 #include "xsk/stdinc.hpp"
 #include "xsk/utils/reader.hpp"
 #include <limits>
+#include <cmath>
 
 using namespace xsk;
 template<class F> auto refuses(F operation) -> void
@@ -11,6 +12,23 @@ template<class F> auto refuses(F operation) -> void
     throw std::runtime_error("expected a bounded-reader refusal");
 }
 
+template<typename T> auto unaligned_scalar(T expected) -> void
+{
+    for (bool strict : { false, true }) for (bool swap : { false, true })
+    {
+        std::array<u8, sizeof(T) + 2> bytes{};
+        std::memcpy(bytes.data() + 1, &expected, sizeof(T));
+        if (swap) std::reverse(bytes.begin() + 1, bytes.end() - 1);
+        utils::reader reader{ bytes.data(), bytes.size(), swap, strict };
+        reader.seek(1);
+        auto value = reader.read<T>();
+        // Compare representations, preserving negative zero and NaN payloads.
+        if (std::memcmp(&value, &expected, sizeof(T)) || reader.pos() != sizeof(T) + 1)
+            throw std::runtime_error("unaligned scalar value or cursor");
+        refuses([&] { reader.read<u16>(); });
+    }
+}
+
 int main()
 {
     try
@@ -19,6 +37,11 @@ int main()
         utils::reader r{ bytes.data(), bytes.size(), false, true };
         if (r.read_cstr() != "a" || r.pos() != 2) throw std::runtime_error("valid string");
         refuses([&] { r.read_cstr(); });
+        if (r.read_bytes(4, 0) != "" || r.read_bytes(0, 2) != "61 00")
+            throw std::runtime_error("strict byte range formatting");
+        refuses([&] { r.read_bytes(5, 0); });
+        refuses([&] { r.read_bytes(3, 2); });
+        refuses([&] { r.read_bytes(0, std::numeric_limits<usize>::max()); });
         if (r.pos() != 2) throw std::runtime_error("failed string moved cursor");
         refuses([&] { r.seek(3); });
         refuses([&] { r.seek(std::numeric_limits<usize>::max()); });
@@ -39,6 +62,20 @@ int main()
         utils::reader old{ bytes.data(), bytes.size() };
         old.seek(5);
         if (old.pos() != 0) throw std::runtime_error("historical seek changed");
+        if (old.read_bytes(0, 2) != "61 00" || old.read_bytes(0, 0) != "")
+            throw std::runtime_error("historical valid/empty byte ranges");
+        unaligned_scalar<i8>(std::numeric_limits<i8>::min());
+        unaligned_scalar<u8>(std::numeric_limits<u8>::max());
+        unaligned_scalar<i16>(std::numeric_limits<i16>::min());
+        unaligned_scalar<u16>(std::numeric_limits<u16>::max());
+        unaligned_scalar<i32>(std::numeric_limits<i32>::min());
+        unaligned_scalar<u32>(std::numeric_limits<u32>::max());
+        unaligned_scalar<i64>(std::numeric_limits<i64>::min());
+        unaligned_scalar<u64>(std::numeric_limits<u64>::max());
+        unaligned_scalar<f32>(1.25f);
+        unaligned_scalar<f32>(-0.0f);
+        unaligned_scalar<f32>(std::numeric_limits<f32>::infinity());
+        unaligned_scalar<f32>(std::numeric_limits<f32>::quiet_NaN());
         return 0;
     }
     catch (std::exception const& e) { std::cerr << e.what() << '\n'; return 1; }
