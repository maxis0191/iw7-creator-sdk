 {
 }
 
+namespace
+{
+template <typename T>
+auto read_scalar(u8 const* data, usize size, usize& pos, bool swap) -> T
+{
+    if (pos > size || sizeof(T) > size - pos)
+        throw reader::error("reader: out of bounds");
+    std::array<u8, sizeof(T)> bytes{};
+    std::memcpy(bytes.data(), data + pos, sizeof(T));
+    if (swap) std::reverse(bytes.begin(), bytes.end());
+    T value;
+    std::memcpy(&value, bytes.data(), sizeof(T));
+    pos += sizeof(T);
+    return value;
+}
+}
+
 template<> auto reader::read() -> i8
 {
-    if (pos_ + 1 > size_)
-        throw error("reader: out of bounds");
-
-    auto value = *reinterpret_cast<i8 const*>(data_ + pos_);
-    pos_ += 1;
-    return value;
+    return read_scalar<i8>(data_, size_, pos_, swap_);
 }
 
