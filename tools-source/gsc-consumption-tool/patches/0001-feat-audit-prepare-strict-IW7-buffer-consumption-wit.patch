new file mode 100644
index 0000000000000000000000000000000000000000..17df94fc1970d175e45dc861339d91f914fa5447
--- /dev/null
+++ b/audit/test_native.py
@@ -0,0 +1,99 @@
+"""Opt-in native negative controls; NOT executed by source-only checks."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+import subprocess
+import unittest
+import zlib
+
+TOOL = None
+
+
+def container(code, stack, compressed=None):
+    compressed = zlib.compress(stack) if compressed is None else compressed
+    return b'GSC\0' + struct.pack('<III', len(compressed), len(stack), len(code)) + compressed + code
+
+
+def function(size, name=b'main\0'):
+    return struct.pack('<II', size, 0) + name
+
+
+class NativeAuditTests(unittest.TestCase):
+    def call(self, raw, success):
+        result = subprocess.run([str(TOOL), '--stdin-gscbin'], input=raw, capture_output=True, timeout=30)
+        if success:
+            self.assertEqual(result.returncode, 0, result.stderr.decode(errors='replace'))
+            self.assertEqual(result.stderr, b'')
+            witness = json.loads(result.stdout)
+            self.assertEqual(witness['input_sha256'], hashlib.sha256(raw).hexdigest())
+            self.assertEqual(witness['bytecode_consumed'], witness['bytecode_bytes'])
+            self.assertEqual(witness['stack_consumed'], witness['stack_bytes'])
+            self.assertTrue(witness['complete_consumption_verified'])
+            return witness
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, b'', 'A failed decoder must not emit a success witness')
+        self.assertIn(b'audit refused:', result.stderr)
+
+    def test_valid_minimal_and_empty_assembler_shape(self):
+        self.call(container(b'\x34\x19', function(1)), True)
+        self.call(container(b'\x34', b''), True)
+
+    def test_valid_string_and_multiple_functions(self):
+        code = b'\x34\x53\0\0\0\0\x19\x19'
+        stack = function(6) + b'hello\0' + function(1, b'second\0')
+        self.assertEqual(len(self.call(container(code, stack), True)['functions']), 2)
+
+    def test_external_token_call_is_reported_not_hidden(self):
+        # Namespace and target use token IDs: no literal module path in stack.
+        stack = function(5) + struct.pack('<II', 1, 2)
+        witness = self.call(container(b'\x34\x2e\0\0\0\x19', stack), True)
+        self.assertIn(b'OP_ScriptFarFunctionCall', bytes.fromhex(witness['assembly_hex']))
+
+    def test_container_truncated_or_trailing(self):
