diff --git a/audit/test_references.py b/audit/test_references.py
index ec7a24a660c53ed62783caa5d2da826f8aa46803..175561f19fa308bbab65b8dcc7be90358bfdf373 100644
--- a/audit/test_references.py
+++ b/audit/test_references.py
@@ -146,6 +146,36 @@ class ReferenceTests(unittest.TestCase):
         empty = self.inspect(container(b'\x53\0\0\0\0\x19', b'\0'))
         self.assertFalse(empty['blockers'])
 
+    def test_animation_second_literal_reports_start_not_end(self):
+        raw = container(b'\x92' + bytes(8) + b'\x19', b'tree\0\x80anim\0')
+        result = self.inspect(raw)
+        self.assertEqual([(b['cause'], b['bytecode_offset'], b['stack_offset']) for b in result['blockers']],
+                         [('unresolved_animation', 1, 18)])
+        instruction = result['functions'][0]['instructions'][0]
+        self.assertEqual((instruction['stack_begin'], instruction['stack_end']), (13, 24))
+        self.assertEqual(result['function_spans'][0]['stack_end'], 24)
+        self.assertFalse(result['encoded_external_script_reference_absence'])
+
+    def test_literal_diagnostics_locate_each_switch_and_indirect_field_operand(self):
+        # Two switch strings; both destinations point to the final Return at 18.
+        body = b'\x3b\x02\0' + struct.pack('<I', 1) + b'\x14\0\0'
+        body += struct.pack('<I', 1) + b'\x06\0\0\x19'
+        result = self.inspect(container(body, b'good\0\x80case\0'))
+        self.assertEqual([(b['cause'], b['stack_offset']) for b in result['blockers']],
+                         [('unresolved_switch_string', 18)])
+        instruction = result['functions'][0]['instructions'][0]
+        self.assertEqual((instruction['stack_begin'], instruction['stack_end']), (13, 24))
+        default_body = b'\x3b\x02\0' + struct.pack('<I', 0) + b'\x14\0\0'
+        default_body += struct.pack('<I', 0) + b'\x06\0\0\x19'
+        result = self.inspect(container(default_body, b'\x01\0bad\0'))
+        self.assertEqual([(b['cause'], b['stack_offset']) for b in result['blockers']],
+                         [('unknown_switch_default_encoding', 15)])
+        # The indirect field token starts at 13; its actual string starts at 17.
+        result = self.inspect(container(b'\x18' + struct.pack('<I', 0x14000) + b'\x19',
+                                        struct.pack('<I', 0) + b'\x80field\0'))
+        self.assertEqual([(b['cause'], b['stack_offset']) for b in result['blockers']],
+                         [('unresolved_field', 17)])
+
