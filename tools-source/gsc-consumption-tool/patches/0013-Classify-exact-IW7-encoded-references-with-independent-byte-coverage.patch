@@ -0,0 +1,272 @@
+"""Lightweight byte-level controls; never starts the native executable."""
+import argparse
+import copy
+import importlib.util
+import json
+from pathlib import Path
+import struct
+import sys
+import unittest
+from unittest.mock import patch
+import subprocess
+from types import SimpleNamespace
+import zlib
+
+import references as r
+from make_reference_profile import make_profile
+
+CONSUMPTION = None
+BEACONS = None
+SOURCE = Path(__file__).resolve().parents[1]
+
+
+def container(body, extra=b'', name=b'main', token=0):
+    stack = struct.pack('<II', len(body), token) + (name + b'\0' if not token else b'') + extra
+    return wrap(b'\x34' + body, stack)
+
+
+def wrap(code, stack):
+    packed = zlib.compress(stack)
+    return b'GSC\0' + struct.pack('<III', len(packed), len(stack), len(code)) + packed + code
+
+
+def literal(value):
+    return b'\0\0\0\0' + value + b'\0'
+
+
+def opcode_control(row, tables):
+    """Minimal encoded specimen for each explicit IW7 profile category."""
+    kind, width = row['kind'], row['bytes']
+    if kind == 'unsupported_size':
+        return container(bytes([row['id'], 0x19]))
+    operands, stack = bytearray(width - 1), b''
+    if kind.startswith('local_'): operands[:3] = b'\xfe\xff\xff'
+    if kind.startswith('external_'): stack = literal(b'scripts/test') + literal(b'main')
+    if kind.startswith('builtin_'):
+        table = tables['methods' if 'method' in kind else 'functions']
+        operands[-2:] = struct.pack('<H', next(iter(table)))
+    if kind == 'field': operands[:] = struct.pack('<I', 1)
+    if kind in ('string', 'animtree', 'animation'): stack = b'text\0' * (2 if kind == 'animation' else 1)
+    if kind == 'branch_back_u16': operands[:] = struct.pack('<H', 3)
+    if kind == 'switch': operands[:] = struct.pack('<i', 1)
+    return container(bytes([row['id']]) + operands + b'\x19', stack)
+
+
+class ReferenceTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        raw_profile = (SOURCE / 'audit/reference-profile.json').read_bytes()
+        p = json.loads(raw_profile)
+        cls.profile_sha = r.sha(raw_profile)
+        cls.profile, cls.tables = r.load_profile(SOURCE, cls.profile_sha, p['tables_sha256'])
+
+    def inspect(self, raw):
+        return r.inspect_bytes(raw, self.profile, self.tables)
+
+    def witness(self, raw):
+        """Synthetic native shape for tamper controls; never labelled execution."""
+        parsed = self.inspect(raw)
+        code, stack = r.unpack(raw)
+        pins = {'decoder': {'source_revision': '1' * 40, 'source_sha256': '2' * 64,
+                           'tables_sha256': self.profile['tables_sha256'], 'tool_sha256': '3' * 64},
+                'profile_sha256': self.profile_sha, 'reference_validator_sha256': r.sha(Path(r.__file__).read_bytes()),
+                'consumption_validator_sha256': r.sha(Path(CONSUMPTION.__file__).read_bytes())}
+        consumption = {'schema': 'iw7.gsc-consumption-native/1', 'engine': 'iw7-pc',
+            'input_bytes': len(raw), 'input_sha256': r.sha(raw), 'bytecode_bytes': len(code), 'bytecode_sha256': r.sha(code),
+            'stack_bytes': len(stack), 'stack_sha256': r.sha(stack), 'bytecode_consumed': len(code), 'stack_consumed': len(stack),
+            'initial_op_end_verified': True, 'branch_targets_verified': True, 'complete_consumption_verified': True,
+            'functions': parsed['function_spans'], 'assembly_hex': '', 'assembly_bytes': 0, 'assembly_sha256': r.sha(b'')}
+        consumption.update({k: v for k, v in pins['decoder'].items() if k != 'tool_sha256'})
+        return {'schema': 'iw7.gsc-reference-native/1', 'profile_sha256': self.profile_sha,
+                'consumption': consumption, 'functions': parsed['functions']}, pins
+
+    def test_profile_provenance_and_exact_reproduction(self):
+        self.assertEqual(make_profile(), self.profile)
+        self.assertEqual(len(self.tables['tokens']), 13220)
+        # Commented-out empty slots in the source are NOT entries in token_map_.
+        self.assertNotIn(0x00C7, self.tables['tokens'])
+        self.assertEqual(self.profile['table_authority'], 'community-source-only')
+
+    def test_changed_table_or_profile_is_refused(self):
+        real_read = r.read
+        def changed_read(path, limit):
+            data = real_read(path, limit)
+            return data + b'\n' if Path(path).name == 'iw7_func.cpp' else data
+        with patch.object(r, 'read', side_effect=changed_read), self.assertRaisesRegex(ValueError, 'Table source pin'):
+            r.load_profile(SOURCE, self.profile_sha, self.profile['tables_sha256'])
+        with self.assertRaisesRegex(ValueError, 'profile pin'):
+            r.load_profile(SOURCE, '0' * 64, self.profile['tables_sha256'])
+
+    def test_original_external_literal_control(self):
+        body = b'\x2e\0\0\0\x2e\0\0\0\x19'
+        stack = literal(b'scripts/engine/utility') + literal(b'flag_exist')
+        stack += literal(b'scripts/engine/utility') + literal(b'flag')
+        result = self.inspect(container(body, stack))
+        self.assertFalse(result['encoded_external_script_reference_absence'])
+        self.assertEqual([x['target']['name'] for x in result['references']], ['flag_exist', 'flag'])
+
+    def test_far_address_alone_blocks_and_numeric_namespace_is_resolved(self):
+        namespace = next(k for k, v in self.tables['tokens'].items() if v.startswith(b'scripts/'))
+        target = next(k for k, v in self.tables['tokens'].items() if v == b'main')
+        raw = container(b'\x60\0\0\0\x19', struct.pack('<II', namespace, target))
+        result = self.inspect(raw)
+        self.assertEqual(result['references'][0]['kind'], 'external_address')
+        self.assertFalse(result['encoded_external_script_reference_absence'])
+        self.assertEqual(result['references'][0]['namespace']['token_id'], namespace)
+
+    def test_local_address_resolves_by_offset_and_invalid_target_refused(self):
+        good = container(b'\xa5\xfe\xff\xff\x19')  # offset -1 from operand -> function at 1
+        self.assertTrue(self.inspect(good)['encoded_external_script_reference_absence'])
+        with self.assertRaisesRegex(ValueError, 'function entry'):
+            self.inspect(container(b'\xa5\0\0\0\x19'))
+
+    def test_every_pointer_opcode_blocks_even_without_far(self):
+        for row in self.profile['opcodes']:
+            if row['kind'] == 'pointer':
+                with self.subTest(opcode=row['name']):
+                    result = self.inspect(container(bytes([row['id']]) + bytes(row['bytes'] - 1) + b'\x19'))
+                    self.assertEqual(result['blockers'][0]['cause'], 'dynamic_call_target')
+                    self.assertFalse(result['encoded_external_script_reference_absence'])
+
+    def test_builtins_are_separate_and_unknown_ids_block(self):
+        token = next(k for k, v in self.tables['functions'].items() if v == b'precachemodel')
+        known = self.inspect(container(b'\x1b' + struct.pack('<H', token) + b'\x19'))
+        self.assertTrue(known['encoded_external_script_reference_absence'])
+        self.assertEqual(known['references'][0]['target']['name'], 'precachemodel')
+        unknown = self.inspect(container(b'\x1b\xff\xff\x19'))
+        self.assertEqual(unknown['blockers'][0]['cause'], 'unresolved_native_symbol')
+        self.assertFalse(unknown['encoded_external_script_reference_absence'])
+
+    def test_assets_separate_strings_not_import_heuristics(self):
+        raw = container(b'\x53\0\0\0\0\x92' + bytes(8) + b'\x94\0\x19',
+                        b'scripts/engine/utility\0tree\0anim\0tree\0')
+        result = self.inspect(raw)
+        self.assertTrue(result['encoded_external_script_reference_absence'])
+        self.assertEqual([x['kind'] for x in result['references']], ['animation', 'animtree'])
+        empty = self.inspect(container(b'\x53\0\0\0\0\x19', b'\0'))
+        self.assertFalse(empty['blockers'])
+
+    def test_unknown_function_field_external_and_encrypted_strings_block(self):
+        cases = [container(b'\x19', token=0xFFFFFF),
+                 container(b'\x18' + struct.pack('<I', 0xC7) + b'\x19'),
+                 container(b'\x18' + struct.pack('<I', 0x14000) + b'\x19', struct.pack('<I', 7)),
+                 container(b'\x60\0\0\0\x19', struct.pack('<I', 0xFFFFFF) + literal(b'main')),
+                 container(b'\x53\0\0\0\0\x19', b'\x80unknown\0')]
+        for raw in cases:
+            with self.subTest(raw=raw):
+                self.assertFalse(self.inspect(raw)['encoded_external_script_reference_absence'])
+
+    def test_switch_table_full_coverage_and_branches(self):
+        # entry starts at 4, target 11, signed offs9 = 3, packed as 6.
+        for key, text in [(0, b'\x01\0'), (1, b'case\0'), (0x800001, b'')]:
+            raw = container(b'\x3b\x01\0' + struct.pack('<I', key) + b'\x06\0\0\x19', text)
+            self.assertEqual(self.inspect(raw)['functions'][0]['instructions'][0]['bytecode_bytes'], 10)
+        with self.assertRaisesRegex(ValueError, 'Branch target'):
+            self.inspect(container(b'\x76\xff\xff\xff\x7f\x19'))
+        with self.assertRaisesRegex(ValueError, 'Switch table'):
+            self.inspect(container(b'\x3b\xff\xff\x19'))
+
+    def test_unmapped_unsupported_and_unclassified_refused(self):
+        for opcode in (0x00, 0x3C, 0x7C):
+            with self.subTest(opcode=opcode), self.assertRaises(ValueError):
+                self.inspect(container(bytes([opcode, 0x19])))
+        broken = copy.deepcopy(self.profile)
+        broken['opcodes'].pop()
+        with self.assertRaisesRegex(ValueError, 'Incomplete'):
+            r.inspect_bytes(container(b'\x19'), broken, self.tables)
+        broken = copy.deepcopy(self.profile)
+        broken['opcodes'][0]['kind'] = 'unreviewed'
+        with self.assertRaisesRegex(ValueError, 'unknown'):
+            r.inspect_bytes(container(b'\x19'), broken, self.tables)
+
+    def test_truncation_suffix_and_container_controls(self):
+        valid = container(b'\x19')
+        for raw in (valid[:-1], valid + b'\0', wrap(b'\x34\x19', struct.pack('<II', 1, 0) + b'main\0junk'),
+                    container(b'\x53\0\0\0\0\x19', b'unterminated'), container(b'\x2e\0\0\0\x19')):
+            with self.subTest(raw=raw), self.assertRaises(ValueError):
+                self.inspect(raw)
+
+    def test_bound_contract_and_guard_flags(self):
+        raw = container(b'\x19')
+        native, pins = self.witness(raw)
+        result = r.validate(raw, native, pins, SOURCE, CONSUMPTION)
+        self.assertTrue(result['encoded_external_script_reference_absence'])
+        for flag in ('native_execution_authenticated', 'native_builtin_semantics_verified',
+                     'asset_dependency_closure_verified', 'retail_runtime_compatibility_verified',
+                     'runtime_validation_passed', 'owner_acceptance', 'package_ready'):
+            self.assertIs(result[flag], False)
+
+    def test_future_native_harness_with_mocked_capture_only(self):
+        import test_reference_native as harness
+        raw = container(b'\x19')
+        native, pins = self.witness(raw)
+        pins['decoder']['tool_sha256'] = r.sha(Path(r.__file__).read_bytes())
+        capture = subprocess.CompletedProcess([], 0, json.dumps(native).encode(), b'')
+        with patch.object(harness, 'ARGS', SimpleNamespace(tool=Path(r.__file__), source_root=SOURCE)), \
+                patch.object(harness, 'PINS', pins), patch.object(harness, 'CONSUMPTION', CONSUMPTION), \
+                patch.object(CONSUMPTION, 'run_bounded', return_value=capture) as mocked:
+            result = harness.NativeReferenceTests().call(raw)
+        self.assertTrue(result[1]['encoded_external_script_reference_absence'])
+        mocked.assert_called_once_with([str(Path(r.__file__)), '--stdin-gscbin-references'], raw)
+
+    def test_false_spans_symbols_oversize_hidden_opcode_and_pin_forgery_refused(self):
+        raw = container(b'\x1a\x01\0\x19')
+        native, pins = self.witness(raw)
+        for field, value in [('bytecode_begin', 2), ('bytecode_bytes', 4), ('opcode', 0x19),
+                             ('stack_begin', 0), ('stack_end', 999), ('bytecode_begin', True)]:
+            changed = copy.deepcopy(native)
+            changed['functions'][0]['instructions'][0][field] = value
+            with self.subTest(field=field, value=value), self.assertRaises(ValueError):
+                r.validate(raw, changed, pins, SOURCE, CONSUMPTION)
+        for mutation in ('name', 'missing', 'extra', 'consumption', 'input', 'profile', 'validator'):
+            changed, changed_pins = copy.deepcopy(native), copy.deepcopy(pins)
+            test_raw = raw
+            if mutation == 'name': changed['functions'][0]['name_hex'] = 'ff'
+            if mutation == 'missing': changed['functions'][0]['instructions'].pop()
+            if mutation == 'extra': changed['functions'][0]['extra'] = True
+            if mutation == 'consumption': changed['consumption']['stack_consumed'] -= 1
+            if mutation == 'input': test_raw = container(b'\x19')
+            if mutation == 'profile': changed_pins['profile_sha256'] = '0' * 64
+            if mutation == 'validator': changed_pins['reference_validator_sha256'] = '0' * 64
+            with self.subTest(mutation=mutation), self.assertRaises(ValueError):
+                r.validate(test_raw, changed, changed_pins, SOURCE, CONSUMPTION)
+
+    def test_all_153_opcodes_have_explicit_positive_or_refusal_controls(self):
+        for row in self.profile['opcodes']:
+            with self.subTest(opcode=row['name']):
+                if row['kind'] == 'unsupported_size':
+                    with self.assertRaisesRegex(ValueError, 'no supported size'):
+                        self.inspect(opcode_control(row, self.tables))
+                    continue
+                result = self.inspect(opcode_control(row, self.tables))
+                self.assertEqual(result['instruction_count'], 2)
+
+    def test_existing_beacon_bytes(self):
+        if not BEACONS:
+            self.skipTest('Pass explicit existing Beacon paths for read-only real-byte controls')
+        variant, original = [Path(p).read_bytes() for p in BEACONS]
+        self.assertEqual(r.sha(variant), 'db486793b92e7e3c0a30c70b565fb432a4940e172a3f97da7e9db377f0e46d42')
+        self.assertEqual(r.sha(original), '31b55a5d58a90d6b980a91543c907d26b91a4f6767d5350e8a35ae0e19fa2cef')
+        positive, negative = self.inspect(variant), self.inspect(original)
+        self.assertEqual(positive['instruction_count'], 570)
+        self.assertEqual(positive['blockers'], [])
+        self.assertTrue(positive['encoded_external_script_reference_absence'])
+        self.assertEqual(negative['instruction_count'], 560)
+        self.assertEqual([(b['bytecode_offset'], b['stack_offset'], b['detail']['target']) for b in negative['blockers']],
+                         [(212, 318, 'flag_exist'), (226, 345, 'flag')])
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--consumption-validator', type=Path, required=True)
+    parser.add_argument('--variant', type=Path)
+    parser.add_argument('--original', type=Path)
+    args = parser.parse_args()
+    if bool(args.variant) != bool(args.original):
+        parser.error('Supply both existing Beacon inputs or neither')
+    spec = importlib.util.spec_from_file_location('consumption_control', args.consumption_validator)
+    CONSUMPTION = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(CONSUMPTION)
+    if args.variant:
+        BEACONS = (args.variant, args.original)
+    unittest.main(argv=[sys.argv[0]], verbosity=2)
