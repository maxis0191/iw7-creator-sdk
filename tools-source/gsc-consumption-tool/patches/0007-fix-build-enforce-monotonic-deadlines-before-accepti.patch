diff --git a/audit/supervision.ps1 b/audit/supervision.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..b4cec15ce5b11114561c71a03619858598f44424
--- /dev/null
+++ b/audit/supervision.ps1
@@ -0,0 +1,66 @@
+# Import defines predicates only; no process, scheduler, lease or native type.
+function Get-AuditMonotonicMs { [Environment]::TickCount64 }
+function Wait-AuditPoll([int]$Milliseconds) { Start-Sleep -Milliseconds $Milliseconds }
+
+function Get-AuditOwnedSnapshot($Owner, [long]$StartedMs) {
+    # Take the timestamp BEFORE getters. Slow getters belong to this observation,
+    # rather than moving the first root-exit time forward and granting more time.
+    $began = (Get-AuditMonotonicMs) - $StartedMs
+    $exited = $Owner.Exited
+    $active = $Owner.Active
+    $exitCode = if ($exited) { $Owner.ExitCode } else { $null }
+    [pscustomobject]@{ ElapsedMs=$began; CompletedMs=((Get-AuditMonotonicMs)-$StartedMs);
+        RootExited=$exited; Active=$active; RootExitCode=$exitCode }
+}
+
+function Wait-AuditOwnedBuild($Owner, $Record, [long]$StartedMs, [scriptblock]$MeasureOutput) {
+    $rootExitedAt = $null
+    while ($true) {
+        $sample = Get-AuditOwnedSnapshot $Owner $StartedMs
+        $Record.LastObservation = $sample
+        if ($sample.RootExited -and $null -eq $rootExitedAt) {
+            $rootExitedAt = $sample.ElapsedMs
+            $Record.RootExitObservedMs = $rootExitedAt
+        }
+        $Record.PeakObservedOutputBytes = [math]::Max($Record.PeakObservedOutputBytes, (& $MeasureOutput))
+        $now = (Get-AuditMonotonicMs) - $StartedMs
+        $Record.ObservationCheckedMs = $now
+        # Every deadline is checked AFTER all observation/measurement work and
+        # BEFORE accepting a closed snapshot. Equality is already too late.
+        if ($Record.PeakObservedOutputBytes -ge 1800MB -or $now -ge 3600000) {
+            throw 'Owned build exceeded storage stop threshold or deadline'
+        }
+        if ($null -ne $rootExitedAt -and $now - $rootExitedAt -ge 2000) {
+            throw 'Unqualified residual compiler/telemetry descendants; drain deadline reached'
+        }
+        if ($sample.RootExited -and $sample.Active -eq 0) {
+            $Record.RootExitCode = $sample.RootExitCode
+            $Record.JobActiveAtClose = 0
+            return
+        }
+        Wait-AuditPoll 250
+    }
+}
+
+function Stop-AuditOwnedBuild($Owner, $Record, [scriptblock]$MeasureOutput) {
+    # Include the time spent by Stop itself in the cleanup deadline.
+    $started = Get-AuditMonotonicMs
+    $Record.StopOriginalJobRequested = $true
+    $Owner.Stop()
+    while ($true) {
+        $sample = Get-AuditOwnedSnapshot $Owner $started
+        $Record.ClosureObservation = $sample
+        $Record.PeakObservedOutputBytes = [math]::Max($Record.PeakObservedOutputBytes, (& $MeasureOutput))
+        $now = (Get-AuditMonotonicMs) - $started
+        $Record.ClosureCheckedMs = $now
+        if ($now -ge 10000) {
+            throw 'Original job closure deadline reached; retain lease'
+        }
+        if ($sample.RootExited -and $sample.Active -eq 0) {
+            $Record.RootExitCode = $sample.RootExitCode
+            $Record.JobActiveAtClose = 0
+            return
+        }
+        Wait-AuditPoll 100
+    }
+}
diff --git a/audit/test_supervision.ps1 b/audit/test_supervision.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..e20f3b7a8f7feb72f5cc61897d2d7e0997f9a106
--- /dev/null
+++ b/audit/test_supervision.ps1
@@ -0,0 +1,92 @@
+# Pure monotonic-clock and owner mocks. No native type, process, lease or sleep.
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'supervision.ps1')
+function Get-AuditMonotonicMs { $script:fixture.Now }
+function Wait-AuditPoll([int]$Milliseconds) { $script:fixture.Now += $Milliseconds }
+function New-Fixture([object[]]$Samples, [long[]]$Measures=@(0), [long]$Initial=0, [long]$StopDelay=0) {
+    $script:fixture = [pscustomobject]@{Now=$Initial; Samples=$Samples; Poll=0; Current=$null;
+        Measures=$Measures; MeasureIndex=0; StopDelay=$StopDelay; Stops=0 }
+    $owner = [pscustomobject]@{}
+    $owner | Add-Member ScriptProperty Exited {
+        $i = [math]::Min($script:fixture.Poll, $script:fixture.Samples.Count - 1)
+        $script:fixture.Current = $script:fixture.Samples[$i]
+        $script:fixture.Poll++
+        $script:fixture.Now += $script:fixture.Current.ExitDelay
+        return $script:fixture.Current.Exited
+    }
+    $owner | Add-Member ScriptProperty Active {
+        $script:fixture.Now += $script:fixture.Current.ActiveDelay
+        return $script:fixture.Current.Active
+    }
+    $owner | Add-Member ScriptProperty ExitCode {
+        $script:fixture.Now += $script:fixture.Current.CodeDelay
+        return 0
+    }
+    $owner | Add-Member ScriptMethod Stop { $script:fixture.Stops++; $script:fixture.Now += $script:fixture.StopDelay }
+    $record = [ordered]@{PeakObservedOutputBytes=[long]0;RootExitCode=$null;JobActiveAtClose=$null}
+    [pscustomobject]@{Owner=$owner;Record=$record}
+}
+function Sample([int]$Active=0, [long]$ExitDelay=0, [long]$ActiveDelay=0, [long]$CodeDelay=0) {
+    [pscustomobject]@{Exited=$true;Active=$Active;ExitDelay=$ExitDelay;ActiveDelay=$ActiveDelay;CodeDelay=$CodeDelay}
+}
+$measure = {
+    $i = [math]::Min($script:fixture.MeasureIndex, $script:fixture.Measures.Count - 1)
+    $script:fixture.Now += $script:fixture.Measures[$i]
+    $script:fixture.MeasureIndex++
+    [long]0
+}
+$script:checks = 0
+function Assert-Check([bool]$Condition, [string]$Message) {
+    if (!$Condition) { throw $Message }
+    $script:checks++
+}
+function Refuse([scriptblock]$Action, [string]$Pattern, $Record) {
+    $caught = $null
+    try { & $Action } catch { $caught = $_.Exception.Message }
+    Assert-Check ($caught -match $Pattern) "Expected refusal matching '$Pattern', got '$caught'"
+    Assert-Check ($null -eq $Record.JobActiveAtClose) 'Late observation must not accept zero active members'
+}
+
+$f = New-Fixture @((Sample)) @(1999)
+Wait-AuditOwnedBuild $f.Owner $f.Record 0 $measure
+Assert-Check ($f.Record.JobActiveAtClose -eq 0 -and $f.Record.RootExitObservedMs -eq 0) '1999 ms drain boundary must pass'
+
+foreach ($cost in @(2000,2001)) {
+    $f = New-Fixture @((Sample)) @($cost)
+    Refuse { Wait-AuditOwnedBuild $f.Owner $f.Record 0 $measure } 'drain deadline' $f.Record
+    Assert-Check ($f.Record.RootExitObservedMs -eq 0) 'Output measurement cost must not shift root exit time'
+}
+foreach ($sample in @((Sample -ExitDelay 2000),(Sample -ActiveDelay 2000),(Sample -CodeDelay 2000))) {
+    $f = New-Fixture @($sample)
+    Refuse { Wait-AuditOwnedBuild $f.Owner $f.Record 0 $measure } 'drain deadline' $f.Record
+}
+$f = New-Fixture @((Sample -Active 1),(Sample -ExitDelay 1750))
+Refuse { Wait-AuditOwnedBuild $f.Owner $f.Record 0 $measure } 'drain deadline' $f.Record
+Assert-Check ($f.Record.LastObservation.ElapsedMs -eq 250 -and $f.Record.ObservationCheckedMs -eq 2000) 'Late second poll crossing must be retained'
+
+$f = New-Fixture @((Sample)) @(0) 3599999
+Wait-AuditOwnedBuild $f.Owner $f.Record 0 $measure
+Assert-Check ($f.Record.JobActiveAtClose -eq 0) 'Global deadline minus one must pass'
+foreach ($fixtureArgs in @(@{Initial=3600000;Measures=@(0)},@{Initial=3599999;Measures=@(1)})) {
+    $f = New-Fixture -Samples @((Sample)) @fixtureArgs
+    Refuse { Wait-AuditOwnedBuild $f.Owner $f.Record 0 $measure } 'stop threshold or deadline' $f.Record
+}
+
+$f = New-Fixture @((Sample)) @(9999)
+Stop-AuditOwnedBuild $f.Owner $f.Record $measure
+Assert-Check ($f.Record.JobActiveAtClose -eq 0 -and $script:fixture.Stops -eq 1) 'Cleanup at 9999 ms must pass after exact Stop'
+foreach ($cost in @(10000,10001)) {
+    $f = New-Fixture @((Sample)) @($cost)
+    Refuse { Stop-AuditOwnedBuild $f.Owner $f.Record $measure } 'closure deadline' $f.Record
+}
+foreach ($sample in @((Sample -ExitDelay 10000),(Sample -ActiveDelay 10000),(Sample -CodeDelay 10000))) {
+    $f = New-Fixture @($sample)
+    Refuse { Stop-AuditOwnedBuild $f.Owner $f.Record $measure } 'closure deadline' $f.Record
+}
+$f = New-Fixture @((Sample)) @(0) 0 10000
+Refuse { Stop-AuditOwnedBuild $f.Owner $f.Record $measure } 'closure deadline' $f.Record
+$f = New-Fixture @((Sample -Active 1),(Sample -ExitDelay 9900))
+Refuse { Stop-AuditOwnedBuild $f.Owner $f.Record $measure } 'closure deadline' $f.Record
+Assert-Check ($f.Record.ClosureObservation.ElapsedMs -eq 100 -and $f.Record.ClosureCheckedMs -eq 10000) 'Late cleanup poll crossing must be retained'
+
+Write-Output "Monotonic supervision: $script:checks checks passed; no native execution."
