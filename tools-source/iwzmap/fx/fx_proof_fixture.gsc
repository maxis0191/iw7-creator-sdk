// FX proof fixture (local private session only; generated by fx_place.py --fixture-out), staged as
// custom_scripts/cp/iwzmap_local.gsc. Command line: +set paris_iwz_mode fxproof +set paris_iwz_fxproof 1
// +set paris_iwz_fxonly -2 [+set paris_iwz_fxphase 0] [+set paris_iwz_fxsel "0,3,5"].
// For every FX k: camera from the first candidate with a clear sight line (floor found by a downward trace), then
//   frame-time phase 2k+1 (FX off, 3 s, no capture), frames iwzf_<k>_off0/off1, FX k on, frames on0..on4 at
//   +0.4/1.0/1.8/2.8/4.0 s, frame-time phase 2k+2 (FX on, 3 s, no capture), FX off.
// Then per zone view: phase 200 (every FX off, 3 s) and phase 201 (every FX on, 3 s).
// Prints [IWZ local] FXPROOF lines (camera, angles, sight line) for fx_proof.py.
init()
{
    if ( getdvarint( "dedicated" ) || getdvar( "paris_iwz_mode" ) != "fxproof" )
        return;
    level thread iwz_fxp_main();
}

iwz_fxp_view( k, origin, yaw, pitch, target, settle )
{
    v = spawnstruct();
    v.k = k;
    v.origin = origin;
    v.yaw = yaw;
    v.pitch = pitch;
    v.target = target;
    v.settle = settle;
    return v;
}

iwz_fxp_quiet()
{
    if ( isdefined( level.flag ) && isdefined( level.flag["pause_wave_progression"] ) )
        scripts\engine\utility::flag_set( "pause_wave_progression" );
    level.zombies_paused = 1;
    foreach ( a in scripts\cp\cp_agent_utils::getaliveagentsofteam( "axis" ) )
        a dodamage( a.health + 10000, a.origin );
}

iwz_fxp_place( player, v )
{
    // camera on the floor below the candidate point, looking at the FX region centre
    top = ( v.origin[0], v.origin[1], v.target[2] + 8 );
    tr = bullettrace( top, top - ( 0, 0, 1200 ), 0, player );
    feet = tr["position"] + ( 0, 0, 1 );
    eye = feet + ( 0, 0, 60 );
    ang = vectortoangles( v.target - eye );
    pitch = ang[0];
    if ( pitch > 180 )
        pitch = pitch - 360;
    r = spawnstruct();
    r.feet = feet;
    r.angles = ( pitch, ang[1], 0 );
    r.los = bullettracepassed( eye, v.target, 0, player );
    return r;
}

iwz_fxp_go( player, r )
{
    player setorigin( r.feet );
    player setplayerangles( r.angles );
    player freezecontrols( 1 );
    player takeallweapons();
}

iwz_fxp_main()
{
    level waittill( "connected", player );
    while ( !isalive( player ) )
        wait 0.2;
    // the start loadout arrives a few seconds after the spawn: wait for it, then keep the view clear
    wait 12;
    player.ignoreme = 1;
    player takeallweapons();
    executecommand( "cg_draw2D 0" );
    print( "[IWZ local] SPAWNED; origin=" + player.origin );
    iwz_fxp_quiet();
    setdvar( "paris_iwz_fxonly", -2 );
    setdvar( "paris_iwz_fxphase", 0 );
    fxv = [];
//@FXVIEWS@
    zv = [];
//@ZONEVIEWS@
    sel = [];
    if ( getdvar( "paris_iwz_fxsel" ) != "" )
    {
        foreach ( t in strtok( getdvar( "paris_iwz_fxsel" ), "," ) )
            sel[int( t )] = 1;
    }
    done = [];
    for ( i = 0; i < fxv.size; i++ )
    {
        k = fxv[i].k;
        if ( isdefined( done[k] ) || ( sel.size && !isdefined( sel[k] ) ) )
            continue;
        // first candidate of FX k with a clear sight line (else the first candidate)
        best = undefined;
        for ( j = i; j < fxv.size && fxv[j].k == k; j++ )
        {
            r = iwz_fxp_place( player, fxv[j] );
            if ( !isdefined( best ) )
                best = r;
            if ( r.los )
            {
                best = r;
                break;
            }
        }
        done[k] = 1;
        v = fxv[i];
        iwz_fxp_quiet();
        setdvar( "paris_iwz_fxonly", -2 );
        iwz_fxp_go( player, best );
        wait 1;
        setdvar( "paris_iwz_fxphase", 2 * k + 1 );
        wait 3;
        setdvar( "paris_iwz_fxphase", 0 );
        player takeallweapons();
        executecommand( "capture_frame iwzf_" + k + "_off0" );
        wait 0.5;
        executecommand( "capture_frame iwzf_" + k + "_off1" );
        wait 0.2;
        setdvar( "paris_iwz_fxonly", k );
        t = 0;
        offs = [ 0.4, 1.0, 1.8, 2.8, 4.0 ];
        for ( n = 0; n < offs.size; n++ )
        {
            wait offs[n] - t;
            t = offs[n];
            executecommand( "capture_frame iwzf_" + k + "_on" + n );
        }
        wait 0.3;
        setdvar( "paris_iwz_fxphase", 2 * k + 2 );
        wait 3;
        setdvar( "paris_iwz_fxphase", 0 );
        setdvar( "paris_iwz_fxonly", -2 );
        print( "[IWZ local] FXPROOF k=" + k + "; feet=" + best.feet + "; angles=" + best.angles + "; los=" + best.los + "; target=" + v.target );
    }
    for ( i = 0; i < zv.size && getdvar( "paris_iwz_fxsel" ) == ""; i++ )
    {
        r = iwz_fxp_place( player, zv[i] );
        r.angles = ( zv[i].pitch, zv[i].yaw, 0 );
        r.feet = zv[i].origin;
        iwz_fxp_quiet();
        iwz_fxp_go( player, r );
        setdvar( "paris_iwz_fxonly", -2 );
        wait 1.5;
        setdvar( "paris_iwz_fxphase", 200 );
        wait 3;
        setdvar( "paris_iwz_fxphase", 0 );
        setdvar( "paris_iwz_fxonly", -1 );
        wait 1.5;
        setdvar( "paris_iwz_fxphase", 201 );
        wait 3;
        setdvar( "paris_iwz_fxphase", 0 );
        print( "[IWZ local] FXPERFVIEW i=" + i + "; feet=" + r.feet );
    }
    setdvar( "paris_iwz_fxonly", -1 );
    print( "[IWZ local] DONE" );
}
