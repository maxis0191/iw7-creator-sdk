@@ -0,0 +1,45 @@
+// Native tests to run only after resource admission and compilation.
+#include "xsk/stdinc.hpp"
+#include "xsk/utils/reader.hpp"
+#include <limits>
+
+using namespace xsk;
+template<class F> auto refuses(F operation) -> void
+{
+    try { operation(); }
+    catch (utils::reader::error const&) { return; }
+    throw std::runtime_error("expected a bounded-reader refusal");
+}
+
+int main()
+{
+    try
+    {
+        std::array<u8, 4> bytes{ 'a', 0, 'b', 'c' };
+        utils::reader r{ bytes.data(), bytes.size(), false, true };
+        if (r.read_cstr() != "a" || r.pos() != 2) throw std::runtime_error("valid string");
+        refuses([&] { r.read_cstr(); });
+        if (r.pos() != 2) throw std::runtime_error("failed string moved cursor");
+        refuses([&] { r.seek(3); });
+        refuses([&] { r.seek(std::numeric_limits<usize>::max()); });
+        refuses([&] { r.seek_neg(3); });
+        refuses([&] { r.pos(5); });
+        refuses([&] { r.align(0); });
+        refuses([&] { r.align(3); });
+        r.pos(3);
+        refuses([&] { r.align(8); });
+        r.seek(1);
+        refuses([&] { r.read<u8>(); });
+        refuses([&] { r.read_cstr(); });
+        std::array<u8, 3> triple{ 1, 2, 3 };
+        utils::reader le{ triple.data(), triple.size(), false, true };
+        utils::reader be{ triple.data(), triple.size(), true, true };
+        if (le.read_i24() != 0x030201 || be.read_i24() != 0x010203)
+            throw std::runtime_error("three-byte read");
+        utils::reader old{ bytes.data(), bytes.size() };
+        old.seek(5);
+        if (old.pos() != 0) throw std::runtime_error("historical seek changed");
+        return 0;
+    }
+    catch (std::exception const& e) { std::cerr << e.what() << '\n'; return 1; }
+}
