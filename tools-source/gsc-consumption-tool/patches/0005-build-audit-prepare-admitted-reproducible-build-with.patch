diff --git a/audit/run_process.ps1 b/audit/run_process.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..a1f8afed0aac84188c0c6d9fa6051ddc0a77c1d2
--- /dev/null
+++ b/audit/run_process.ps1
@@ -0,0 +1,66 @@
+[CmdletBinding()]
+param([Parameter(Mandatory)][string]$Spec)
+$ErrorActionPreference = 'Stop'
+$data = Get-Content -LiteralPath $Spec -Raw | ConvertFrom-Json
+$outputRoot = [IO.Path]::GetFullPath($data.output_root)
+function Measure-Output {
+    $sum = (Get-ChildItem -LiteralPath $outputRoot -Recurse -File -Force | Measure-Object Length -Sum).Sum
+    if ($null -eq $sum) { return [long]0 }
+    return [long]$sum
+}
+$info = [Diagnostics.ProcessStartInfo]::new()
+$info.FileName = $data.command[0]
+$info.WorkingDirectory = $data.cwd
+$info.UseShellExecute = $false
+$info.CreateNoWindow = $true
+$info.RedirectStandardOutput = $true
+$info.RedirectStandardError = $true
+foreach ($argument in @($data.command | Select-Object -Skip 1)) { [void]$info.ArgumentList.Add([string]$argument) }
+$process = [Diagnostics.Process]::new()
+$process.StartInfo = $info
+$out = [IO.File]::Create($data.stdout)
+$err = [IO.File]::Create($data.stderr)
+$result = [ordered]@{ command=$data.command; pid=$null; creation_utc=$null; exit_code=$null; peak_output_bytes=[long]0; failure=$null }
+$watch = [Diagnostics.Stopwatch]::StartNew()
+$started = $false
+$stdoutTask = $null
+$stderrTask = $null
+try {
+    if (-not $process.Start()) { throw 'Owned process did not start' }
+    $started = $true
+    $result.pid = $process.Id
+    $result.creation_utc = $process.StartTime.ToUniversalTime().ToString('o')
+    $process.PriorityClass = 'BelowNormal'
+    $stdoutTask = $process.StandardOutput.BaseStream.CopyToAsync($out)
+    $stderrTask = $process.StandardError.BaseStream.CopyToAsync($err)
+    while (-not $process.WaitForExit(250)) {
+        $size = Measure-Output
+        $result.peak_output_bytes = [math]::Max($result.peak_output_bytes, $size)
+        if ($size -ge $data.stop_bytes -or $watch.Elapsed.TotalSeconds -gt $data.timeout_seconds) {
+            throw 'Output storage guard or process timeout reached'
+        }
+    }
+    $result.exit_code = $process.ExitCode
+} catch {
+    $result.failure = $_.Exception.Message
+} finally {
+    if ($started -and -not $process.HasExited) {
+        # Retained Process object + .NET descendant handling, never taskkill by a
+        # bare PID. This affects only the process tree started by this invocation.
+        $process.Kill($true)
+        if (-not $process.WaitForExit(30000)) { throw 'Owned build tree did not exit; keep lease quarantined' }
+    }
+    if ($started) { $result.exit_code = $process.ExitCode }
+    foreach ($task in @($stdoutTask, $stderrTask)) {
+        if ($null -ne $task -and -not $task.Wait(30000)) { $result.failure = 'Output pipe drain timed out' }
+    }
+    $out.Dispose()
+    $err.Dispose()
+    $result.peak_output_bytes = [math]::Max($result.peak_output_bytes, (Measure-Output))
+    $result.elapsed_seconds = $watch.Elapsed.TotalSeconds
+    $result.storage_limit_exceeded = $result.peak_output_bytes -gt $data.limit_bytes
+    $result | ConvertTo-Json -Depth 6 | Set-Content -LiteralPath $data.result -Encoding utf8
+    $process.Dispose()
+}
+if ($result.failure -or $result.exit_code -ne 0 -or $result.storage_limit_exceeded) { exit 1 }
+exit 0
diff --git a/audit/test_plan.py b/audit/test_plan.py
new file mode 100644
index 0000000000000000000000000000000000000000..ecc2a04f19b928a0f107f15bf82348a40e65fc29
--- /dev/null
+++ b/audit/test_plan.py
@@ -0,0 +1,88 @@
+"""Pure preparation/provenance tests; no Git copy, compiler or native executable."""
+import tempfile
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+
+import prepare
+
+
+class PreparationTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.files = ['audit/main.cpp', 'src/gsc/engine/iw7.cpp', 'include/xsk/gsc/engine/iw7.hpp',
+                      'include/xsk/gsc/common/assembly.hpp', 'src/gsc/context.cpp']
+        for name in self.files:
+            path = self.root / name
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_text(name)
+        self.zlib = self.root / 'deps/zlib'
+        self.zlib.mkdir(parents=True)
+        self.zlib_dirty = False
+        self.zlib_revision = 'b' * 40
+        def fake_git(*args, root=None):
+            if root == self.zlib:
+                if args[0] == 'status':
+                    return ' M adler32.c' if self.zlib_dirty else ''
+                if args[0] == 'rev-parse':
+                    return self.zlib_revision
+                return 'adler32.c'
+            if args[0] == 'status':
+                return ''
+            if args[0] == 'ls-files':
+                return '\n'.join(self.files)
+            return 'b' * 40 if args[-1] == 'HEAD:deps/zlib' else 'a' * 40
+        self.addCleanup(patch.stopall)
+        patch.object(prepare, 'ROOT', self.root).start()
+        patch.object(prepare, 'git', side_effect=fake_git).start()
+
+    def materialize(self):
+        (self.zlib / '.git').touch()
+        (self.zlib / 'adler32.c').write_text('dependency source')
+
+    def test_uninitialized_dependency_cannot_produce_build_identity(self):
+        source = prepare.inspect_sources(require_zlib=False)
+        self.assertIsNone(source['source_sha256'])
+        self.assertFalse(source['dependencies_materialized'])
+        with self.assertRaisesRegex(ValueError, 'Initialize pinned zlib'):
+            prepare.prepare(self.root / 'build/identity')
+        self.assertFalse((self.root / 'build').exists())
+
+    def test_dependency_bytes_bind_full_source_without_changing_tool_or_tables(self):
+        before = prepare.inspect_sources(require_zlib=False)
+        self.materialize()
+        bound = prepare.inspect_sources()
+        self.assertEqual(before['tool_source_sha256'], bound['tool_source_sha256'])
+        self.assertEqual(before['tables_sha256'], bound['tables_sha256'])
+        self.assertTrue(bound['dependencies_materialized'])
+        (self.zlib / 'adler32.c').write_text('changed source')
+        changed = prepare.inspect_sources()
+        self.assertNotEqual(bound['source_sha256'], changed['source_sha256'])
+        self.assertNotEqual(bound['zlib_source_sha256'], changed['zlib_source_sha256'])
+
+    def test_dirty_or_wrong_revision_dependency_is_refused(self):
+        self.materialize()
+        self.zlib_dirty = True
+        with self.assertRaises(ValueError):
+            prepare.inspect_sources()
+        self.zlib_dirty = False
+        self.zlib_revision = 'c' * 40
+        with self.assertRaises(ValueError):
+            prepare.inspect_sources()
+
+    def test_identity_requires_fresh_ignored_path_and_embeds_full_hash(self):
+        self.materialize()
+        with self.assertRaises(ValueError):
+            prepare.prepare(self.root / 'outside')
+        target = self.root / 'build/identity'
+        source = prepare.prepare(target)
+        self.assertIn(source['source_sha256'], (target / 'audit_identity.hpp').read_text())
+        self.assertEqual(source['zlib_commit'], 'b' * 40)
+        with self.assertRaises(ValueError):
+            prepare.prepare(target)
+
+
+if __name__ == '__main__':
+    unittest.main()
