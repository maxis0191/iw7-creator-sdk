diff --git a/audit/diagnostics.ps1 b/audit/diagnostics.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..5e1e18573bf0cb2d8fabac0f943cc3441e744e4b
--- /dev/null
+++ b/audit/diagnostics.ps1
@@ -0,0 +1,68 @@
+# Read-only residual observation. Import compiles/starts nothing and owns nothing.
+function Get-AuditOriginalJobMembers($Owner) { [IW7.AnimationRig.JobMembers]::Capture($Owner) }
+
+function Get-AuditImageFileWitness([string]$Path, $Budget) {
+    # This is a hash of the image FILE while locked against write/delete, not a
+    # claim that loaded pages match it or that the member is harmless telemetry.
+    $stream=[IO.File]::Open($Path,'Open','Read','Read')
+    try {
+        if ($stream.Length -le 0 -or $stream.Length -gt 64MB -or $Budget.Bytes+$stream.Length -gt 128MB) {
+            throw 'Residual image hash byte budget exceeded'
+        }
+        $hash=[Security.Cryptography.SHA256]::Create()
+        try {
+            $buffer=[byte[]]::new(262144)
+            while (($count=$stream.Read($buffer,0,$buffer.Length)) -gt 0) {
+                $Budget.Bytes+=$count
+                if ($Budget.Bytes -gt 128MB -or (Get-AuditMonotonicMs)-$Budget.StartedMs -ge 1000) {
+                    throw 'Residual image hash time/byte budget exceeded'
+                }
+                [void]$hash.TransformBlock($buffer,0,$count,$null,0)
+            }
+            [void]$hash.TransformFinalBlock([byte[]]::new(0),0,0)
+            if ((Get-AuditMonotonicMs)-$Budget.StartedMs -ge 1000) { throw 'Residual observation deadline reached' }
+            [ordered]@{SHA256=[Convert]::ToHexString($hash.Hash).ToLowerInvariant();Bytes=$stream.Length;
+                Scope='ImageFileBytesUnderReadGuard'}
+        } finally { $hash.Dispose() }
+    } finally { $stream.Dispose() }
+}
+
+function Save-AuditResidualObservation($Owner, $Record) {
+    # Rig's telemetry classifier requires a direct cl child and PID-bound compile
+    # receipt. CMake/MSBuild has neither contract: this path is DIAGNOSTIC ONLY.
+    $budget=[ordered]@{StartedMs=(Get-AuditMonotonicMs);Bytes=0L}
+    $diagnostic=[ordered]@{Mode='ObservationOnly';ClassifierApplicable=$false;AcceptanceGranted=$false;
+        DeadlineMs=1000;MaxMembers=64;MaxImageBytes=64MB;MaxTotalImageBytes=128MB;
+        Observation=$null;Images=@();Complete=$false;Error=$null}
+    $Record.ResidualDiagnostic=$diagnostic
+    try {
+        $observation=Get-AuditOriginalJobMembers $Owner
+        $diagnostic.Observation=$observation
+        $members=@($observation.Members)
+        if ($members.Count -gt 64 -or $observation.AssignedCount -ne $members.Count -or
+            $observation.ListedCount -ne $members.Count) { throw 'Incomplete bounded original-job observation' }
+        foreach ($member in $members) {
+            if ((Get-AuditMonotonicMs)-$budget.StartedMs -ge 1000) { throw 'Residual observation deadline reached' }
+            $entry=[ordered]@{PID=$member.PID;CreatedUtc=$member.CreatedUtc;Image=$member.Image;
+                ParentPID=$member.ParentPID;InOriginalJob=$member.InOriginalJob;ImageFile=$null;Error=$null}
+            $diagnostic.Images+=,$entry
+            $timestamp=[datetimeoffset]::MinValue
+            if ($member.InOriginalJob -isnot [bool] -or !$member.InOriginalJob -or $member.Error -or $member.ParentError -or
+                !$member.ParentPID -or !$member.Image -or ![IO.Path]::IsPathFullyQualified($member.Image) -or
+                ![datetimeoffset]::TryParseExact($member.CreatedUtc,'o',[Globalization.CultureInfo]::InvariantCulture,
+                    [Globalization.DateTimeStyles]::None,[ref]$timestamp) -or $timestamp.Offset -ne [timespan]::Zero) {
+                $entry.Error='Original job member identity incomplete; no image hash attempted'
+                continue
+            }
+            try { $entry.ImageFile=Get-AuditImageFileWitness $member.Image $budget }
+            catch { $entry.Error=$_.Exception.Message }
+        }
+        if ((Get-AuditMonotonicMs)-$budget.StartedMs -ge 1000) { throw 'Residual observation deadline reached' }
+        $diagnostic.Complete=(@($diagnostic.Images|Where-Object Error).Count -eq 0)
+    } catch { $diagnostic.Error=$_.Exception.Message }
+    finally {
+        $diagnostic.ElapsedMs=(Get-AuditMonotonicMs)-$budget.StartedMs
+        $diagnostic.HashedBytes=$budget.Bytes
+    }
+    # No Stop, Dispose, lease release, PID action or success override here.
+}
