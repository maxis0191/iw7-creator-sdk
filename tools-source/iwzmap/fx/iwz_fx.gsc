// Ambient FX module (generated by tools-source/iwzmap/fx/fx_place.py from fx.txt; do not edit by hand).
// Effects are registered with loadfx in main(); this thread spawns them after the first frame.
//   loop       spawnfx + triggerfx( ent, delay ): a looping vfx asset keeps emitting (stock createfx oneshot route)
//   retrigger  spawnfx once, triggerfx again every min seconds
//   interval   playfx every randomfloatrange( min, max ) seconds
//   oneshot    playfx once
//   flicker    looping effect switched off/on in short stutters every randomfloatrange( min, max ) seconds (a dying
//              lamp's glow; same rhythm as iwz_flicker's lamp models)
// Stages (fx.txt stage=): always, dark (until the level flag power_on), lit (from power on), poweron (from power on
// for f.dur seconds: generator start-up burst).
// Private proof runs only (dvar paris_iwz_fxproof set by the fixture command line): paris_iwz_fxonly selects the
// running effects (-1 all, -2 none, k only effect k), polled every 0.1 s. A normal match never polls.
iwz_fx_main()
{
    level endon( "game_ended" );
    level.iwz_fx = [];
//@FXTABLE@
    wait 1;
    if ( getdvar( "paris_iwz_fxproof" ) == "" )
    {
        // stages: always + dark run from the start; at power on dark stops, lit starts, poweron plays for its time
        n = 0;
        foreach ( f in level.iwz_fx )
        {
            if ( f.stage == "always" || f.stage == "dark" )
            {
                iwz_fx_start( f );
                n++;
            }
        }
        print( "[IWZ level] FX_ON " + n + " of " + level.iwz_fx.size );
        level thread iwz_fx_power();
        return;
    }
    state = -99;
    for ( ;; )
    {
        s = getdvar( "paris_iwz_fxonly" );
        want = -1;
        if ( s != "" )
            want = int( s );
        if ( want != state )
        {
            foreach ( f in level.iwz_fx )
                iwz_fx_stop( f );
            for ( k = 0; k < level.iwz_fx.size; k++ )
            {
                if ( want == -1 || want == k )
                    iwz_fx_start( level.iwz_fx[k] );
            }
            state = want;
            print( "[IWZ level] FXSTATE " + state );
        }
        wait 0.1;
    }
}

// power stage switch: the stock generator sets the level flag "power_on" (Spaceland power system)
iwz_fx_power()
{
    level endon( "game_ended" );
    while ( !scripts\engine\utility::flag_exist( "power_on" ) )
        wait 0.5;
    scripts\engine\utility::flag_wait( "power_on" );
    n = 0;
    foreach ( f in level.iwz_fx )
    {
        if ( f.stage == "dark" )
            iwz_fx_stop( f );
        else if ( f.stage == "lit" || f.stage == "poweron" )
        {
            iwz_fx_start( f );
            n++;
            if ( f.stage == "poweron" && f.dur > 0 )
                level thread iwz_fx_stop_after( f, f.dur );
        }
    }
    print( "[IWZ level] FX_POWER started=" + n );
}

iwz_fx_stop_after( f, t )
{
    level endon( "game_ended" );
    wait t;
    iwz_fx_stop( f );
}

iwz_fx_def( name, key, origin, fwd, up, mode, delay, a, b, stage, dur )
{
    f = spawnstruct();
    f.stage = stage;
    f.dur = dur;
    f.name = name;
    f.key = key;
    f.origin = origin;
    f.fwd = fwd;
    f.up = up;
    f.mode = mode;
    f.delay = delay;
    f.a = a;
    f.b = b;
    return f;
}

iwz_fx_start( f )
{
    if ( f.mode == "loop" || f.mode == "retrigger" )
    {
        f.ent = spawnfx( level._effect[f.key], f.origin, f.fwd, f.up );
        if ( f.mode == "loop" )
            triggerfx( f.ent, f.delay );
        else
        {
            triggerfx( f.ent );
            f thread iwz_fx_retrigger();
        }
    }
    else if ( f.mode == "flicker" )
        f thread iwz_fx_flicker();
    else
        f thread iwz_fx_plays();
}

iwz_fx_stop( f )
{
    f notify( "iwz_fx_stop" );
    if ( isdefined( f.ent ) )
    {
        f.ent delete();
        f.ent = undefined;
    }
}

iwz_fx_retrigger()
{
    self endon( "iwz_fx_stop" );
    level endon( "game_ended" );
    for ( ;; )
    {
        wait self.a;
        if ( isdefined( self.ent ) )
            triggerfx( self.ent );
    }
}

iwz_fx_flicker()
{
    self endon( "iwz_fx_stop" );
    level endon( "game_ended" );
    self.ent = spawnfx( level._effect[self.key], self.origin, self.fwd, self.up );
    triggerfx( self.ent );
    for ( ;; )
    {
        wait randomfloatrange( self.a, self.b );
        n = randomintrange( 2, 5 );
        for ( i = 0; i < n; i++ )
        {
            self.ent delete();
            self.ent = undefined;
            wait randomfloatrange( 0.05, 0.15 );
            self.ent = spawnfx( level._effect[self.key], self.origin, self.fwd, self.up );
            triggerfx( self.ent );
            wait randomfloatrange( 0.05, 0.2 );
        }
    }
}

iwz_fx_plays()
{
    self endon( "iwz_fx_stop" );
    level endon( "game_ended" );
    if ( self.delay > 0 )
        wait self.delay;
    if ( self.mode == "oneshot" )
    {
        playfx( level._effect[self.key], self.origin, self.fwd, self.up );
        return;
    }
    for ( ;; )
    {
        playfx( level._effect[self.key], self.origin, self.fwd, self.up );
        wait randomfloatrange( self.a, self.b );
    }
}
