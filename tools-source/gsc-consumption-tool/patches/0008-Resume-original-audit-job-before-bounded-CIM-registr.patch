+$f=New-Fixture
+Complete-AuditOwnedCleanup $f.Owner $f.Record $false $measure $release
+Assert-Check ($f.Record.TreeClosed -and $f.Record.LeaseReleased -and $script:fixture.Stops -eq 1 -and $script:fixture.Disposes -eq 1 -and $script:fixture.Releases -eq 1) 'Confirmed original job closure permits release'
+
+$source=[IO.File]::ReadAllText((Join-Path $PSScriptRoot 'build.ps1'))
+Assert-Check ($source.IndexOf('$closed = $false') -lt $source.IndexOf('[IW7.CommunityBuild.BuildJob]::Prepare')) 'Factory starts with unknown closure'
+Assert-Check ($source.IndexOf('Get-AuditOriginalIdentity $owner') -lt $source.IndexOf('$owner.Resume()')) 'Capture identity before Resume'
+Assert-Check ($source.IndexOf('$owner.Resume()') -lt $source.IndexOf('Register-AuditOwnedBuild $owner')) 'Resume before bounded registration'
+Assert-Check ($source -notmatch 'Stop-Process|taskkill|WaitForExit|Start-Process|Add-IW7ResourceProcess') 'Launcher has no PID-only identity/closure path'
+Write-Output "Registration and quarantine: $script:checks checks passed; no native execution."
