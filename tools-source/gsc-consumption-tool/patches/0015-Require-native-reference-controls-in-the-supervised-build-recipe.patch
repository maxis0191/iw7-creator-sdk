+        for key in ('python', 'pwsh', 'cmake', 'ctest', 'scheduler', 'job_source', 'members_source', 'wrapper'):
+            self.plan[key], self.plan[key + '_sha256'] = key, 'a' * 64
+        for key, relative in build.REFERENCE_FILES.items():
