{
 "schema": "iw7.gamelab-plan/1",
 "name": "i1_mk_trig",
 "map": "cp_iwz",
 "conditions": "quiet",
 "libraries": [
  "szaccept",
  "szi1"
 ],
 "about": "I1 (29 Nov), a client, an experiment: the stock monitor stopped, the rifle use trigger set by the stock code at its struct (behind the stall clip), then moved in front of the clip; the SMG as the control.",
 "steps": [
  {
   "do": "waves",
   "on": false
  },
  {
   "do": "call",
   "fn": "sz_power_direct",
   "args": [
    "power",
    20
   ],
   "s": 1
  },
  {
   "do": "wait",
   "s": 6
  },
  {
   "do": "money",
   "value": 20000
  },
  {
   "do": "tp",
   "at": [
    -1490,
    4285,
    1
   ],
   "yaw": 90
  },
  {
   "do": "look",
   "yaw": 90,
   "pitch": 0
  },
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "call",
   "fn": "i1_trig_set",
   "args": [
    "at_struct",
    "iw7_m1c_zm",
    -1490,
    4336,
    0
   ],
   "s": 2
  },
  {
   "do": "ui",
   "name": "set_at_struct"
  },
  {
   "do": "capture",
   "name": "i1_mk_set_struct",
   "pause": 1
  },
  {
   "do": "call",
   "fn": "i1_trig_set",
   "args": [
    "in_front",
    "iw7_m1c_zm",
    -1490,
    4336,
    4294
   ],
   "s": 2
  },
  {
   "do": "ui",
   "name": "set_in_front"
  },
  {
   "do": "capture",
   "name": "i1_mk_set_front",
   "pause": 1
  },
  {
   "do": "tp",
   "at": [
    -1880,
    4420,
    1
   ],
   "yaw": 180,
   "snap": true
  },
  {
   "do": "look",
   "yaw": 180,
   "pitch": 10
  },
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "call",
   "fn": "i1_trig_set",
   "args": [
    "smg_ctrl",
    "iw7_ump45_zml",
    -1948,
    4440,
    0
   ],
   "s": 2
  },
  {
   "do": "ui",
   "name": "set_smg"
  },
  {
   "do": "expect",
   "that": "probe:at_struct.found",
   "eq": 1,
   "why": "the rifle struct"
  }
 ]
}