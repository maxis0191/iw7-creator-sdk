+
+    def test_last_function_size_zero_too_short_and_too_long(self):
+        for code, stack in ((b'\x34\x19', function(0)), (b'\x34\x19', function(2)),
+                            (b'\x34\x53\0\0\0\0\x19', function(1) + b'value\0')):
+            with self.subTest(code=code, stack=stack):
+                self.call(container(code, stack), False)
+
+    def test_truncated_function_header_and_unterminated_name(self):
+        for stack in (b'\1', struct.pack('<II', 1, 0), function(1, b'main')):
+            with self.subTest(stack=stack):
+                self.call(container(b'\x34\x19', stack), False)
+
+    def test_unterminated_instruction_string_and_out_of_bounds_seek(self):
+        self.call(container(b'\x34\x53\0\0\0\0\x19', function(6) + b'value'), False)
