+function Complete-AuditOwnedCleanup($Owner, $Record, [bool]$Closed, [scriptblock]$MeasureOutput, [scriptblock]$ReleaseLease) {
+    if ($Owner -and !$Closed) {
+        try { Stop-AuditOwnedBuild $Owner $Record $MeasureOutput; $Closed=$true }
+        catch { $Record.ClosureError=$_.Exception.Message }
+    }
+    # A failed factory with no returned handle is unknown, not closed.
+    $Record.TreeClosed=$Closed
+    if ($Closed) {
+        try {
+            if ($Owner) { $Owner.Dispose() }
+            & $ReleaseLease
+            $Record.LeaseReleased=$true
+        } catch { $Record.LeaseError=$_.Exception.Message; $Record.Success=$false }
+    } else {
+        $script:GscAuditUnclosedOwner=$Owner
+        $Record.LeaseRetainedReason='Original root/job closure unconfirmed'
+        $Record.Success=$false
+    }
+}
