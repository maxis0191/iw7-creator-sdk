@@ -0,0 +1,52 @@
+"""Generate build identity only. Does not configure, compile, download or execute native code."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def git(*args):
+    return subprocess.check_output(['git', '-C', str(ROOT), *args], text=True).strip()
+
+
+def digest(files):
+    records = [{'path': p.as_posix(), 'sha256': hashlib.sha256((ROOT / p).read_bytes()).hexdigest()}
+               for p in sorted(files)]
+    return hashlib.sha256(json.dumps(records, sort_keys=True, separators=(',', ':')).encode()).hexdigest(), records
+
+
+def prepare(output):
+    if git('status', '--porcelain', '--untracked-files=all'):
+        raise ValueError('A clean committed source checkout is required')
+    output = output.resolve()
+    if output.exists() or not output.is_relative_to(ROOT / 'build'):
+        raise ValueError('Use a fresh ignored identity directory under build/')
+    files = [Path(p) for p in git('ls-files').splitlines()
+             if p.startswith(('src/', 'include/', 'audit/')) and (ROOT / p).is_file()]
+    tables = [p for p in files if p.as_posix().startswith('src/gsc/engine/iw7')]
+    tables += [Path('include/xsk/gsc/engine/iw7.hpp'), Path('include/xsk/gsc/common/assembly.hpp'),
+               Path('src/gsc/context.cpp')]
+    source_hash, source_records = digest(files)
+    table_hash, table_records = digest(set(tables))
+    revision = git('rev-parse', 'HEAD')
+    output.mkdir(parents=True)
+    header = ('#pragma once\n' + ''.join(f'#define AUDIT_{key} "{value}"\n' for key, value in
+              [('SOURCE_REVISION', revision), ('SOURCE_SHA256', source_hash), ('TABLES_SHA256', table_hash)]))
+    (output / 'audit_identity.hpp').write_text(header, encoding='utf-8', newline='\n')
+    manifest = {'schema': 'iw7.gsc-audit-build-source/1', 'source_revision': revision,
+                'source_sha256': source_hash, 'tables_sha256': table_hash,
+                'source_files': source_records, 'table_files': table_records,
+                'zlib_commit': git('rev-parse', 'HEAD:deps/zlib'), 'native_built': False}
+    (output / 'source-manifest.json').write_text(json.dumps(manifest, indent=2) + '\n', encoding='utf-8', newline='\n')
+    return manifest
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', required=True, type=Path)
+    args = parser.parse_args()
+    result = prepare(args.output)
+    print(json.dumps({key: value for key, value in result.items() if not key.endswith('_files')}, indent=2))
