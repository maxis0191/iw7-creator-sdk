+        for mocked in (patch.object(build.prepare, 'inspect_sources', return_value=self.source),
+                       patch.object(build.prepare, 'git', return_value='e' * 40),
+                       patch.object(build, 'sha_file', return_value='a' * 64),
+                       patch.object(build.shutil, 'disk_usage', return_value=SimpleNamespace(free=10 * build.GIB))):
+            mocked.start()
+            self.addCleanup(mocked.stop)
+
+    def test_complete_plan_accepted_and_legacy_refused(self):
+        build.validate_plan(self.plan)
+        self.plan['schema'] = 'iw7.gsc-audit-build-plan/1'
+        with self.assertRaisesRegex(ValueError, 'reference phase'):
+            build.validate_plan(self.plan)
+
+    def test_all_three_reference_paths_and_hashes_bound(self):
+        for key in build.REFERENCE_FILES:
+            for field, value in [(key, str(build.ROOT / 'other.py')), (key + '_sha256', 'f' * 64)]:
+                candidate = copy.deepcopy(self.plan)
+                candidate[field] = value
+                with self.subTest(field=field), self.assertRaisesRegex(ValueError, 'reference source'):
+                    build.validate_plan(candidate)
+
+    def test_runtime_pins_bind_built_executable_and_independent_readers(self):
+        pins = build.reference_pins(self.plan, self.source, 'f' * 64)
+        self.assertEqual(pins['decoder'], {'tool_sha256': 'f' * 64, 'source_revision': 'b' * 40,
+                                         'source_sha256': 'd' * 64, 'tables_sha256': 'a' * 64})
