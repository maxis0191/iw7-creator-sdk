diff --git a/audit/test_completion_files.ps1 b/audit/test_completion_files.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..00a717387d2b376e908ba829083c17fbb0add50f
--- /dev/null
+++ b/audit/test_completion_files.ps1
@@ -0,0 +1,43 @@
+$ErrorActionPreference='Stop'
+. (Join-Path $PSScriptRoot 'completion.ps1')
+$script:checks=0
+function Check([bool]$Value,[string]$Message) {if (!$Value) {throw $Message};$script:checks++}
+function State { @{Guards=[Collections.Generic.List[object]]::new();Files=@{};Bytes=0L} }
+$path=Join-Path $PSScriptRoot 'completion.ps1'
+$state=State
+try {
+    $file=Open-AuditCompletionFile $path 1MB $false $state {}
+    Check ($file.SHA256 -ceq (Get-FileHash -LiteralPath $path).Hash.ToLowerInvariant()) 'Streaming SHA matches source bytes'
+    Check ($state.Guards.Count -eq 1 -and $state.Guards[0].CanRead) 'Read guard remains live after hash returns'
+    $write=$null;$blocked=$false
+    try {$write=[IO.File]::Open($path,'Open','Write','ReadWrite')} catch {$blocked=$true} finally {if ($write){$write.Dispose()}}
+    Check $blocked 'Live source read guard denies a concurrent writer'
+    $cached=Open-AuditCompletionFile $path 1MB $false $state {}
+    Check ($state.Guards.Count -eq 1 -and $state.Bytes -eq $file.Bytes -and $cached.SHA256 -eq $file.SHA256) 'Guarded file cache cannot introduce another read generation'
+} finally {Close-AuditCompletionFiles $state}
+Check (!$state.Guards[0].CanRead) 'Guard disposed at owned scope end'
+foreach ($mode in @('file-bytes','aggregate','file-count','slow-read')) {
+    $state=State;$maximum=1MB;$script:clocks=0;$check={}
+    if ($mode -eq 'file-bytes') {$maximum=1}
+    if ($mode -eq 'aggregate') {$state.Bytes=128MB}
+    if ($mode -eq 'file-count') {1..32|ForEach-Object {[void]$state.Guards.Add([IO.MemoryStream]::new())}}
+    if ($mode -eq 'slow-read') {$check={$script:clocks++;if($script:clocks -ge 3){throw 'clock expired after stream read'}}}
+    $caught=$null
+    try {Open-AuditCompletionFile $path $maximum $false $state $check|Out-Null} catch {$caught=$_.Exception.Message}
+    finally {Close-AuditCompletionFiles $state}
+    Check (![string]::IsNullOrEmpty($caught)) "Bounded reader refuses $mode"
+    Check (@($state.Guards|Where-Object CanRead).Count -eq 0) "Refusal closes all $mode guards"
+}
+# A tiny synthetic JSON file is the only write; no build/Plan/native artifact.
+$temporary=[IO.Path]::GetTempFileName()
+try {
+    foreach ($body in @('{"ok":true}','{"same":1,"same":2}','{"key":1,"KEY":2}')) {
+        [IO.File]::WriteAllText($temporary,$body,[Text.UTF8Encoding]::new($false))
+        $state=State;$caught=$null;$file=$null
+        try {$file=Open-AuditCompletionFile $temporary 1024 $true $state {}} catch {$caught=$_.Exception.Message}
+        finally {Close-AuditCompletionFiles $state}
+        if ($body -eq '{"ok":true}') {Check ($file.Json.ok -eq $true -and !$caught) 'Bounded JSON parsed under retained read guard'}
+        else {Check ($caught -match 'Duplicate') 'Duplicate or case-ambiguous JSON keys rejected'}
+    }
+} finally {[IO.File]::Delete($temporary)}
+Write-Output "Completion file guards: $script:checks checks passed; small managed source/JSON I/O only."
diff --git a/audit/test_owned_closure.ps1 b/audit/test_owned_closure.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..16417237bb75ccad183d6594a4e24b6b137ae7b3
--- /dev/null
+++ b/audit/test_owned_closure.ps1
@@ -0,0 +1,117 @@
+# Imports/runs the 57 synthetic receipt cases, then exercises the real orchestrator
+# against owned-handle, member-query, file-guard and monotonic-clock mocks.
+. (Join-Path $PSScriptRoot 'test_completion.ps1')
+$script:checks=0
+function Get-AuditMonotonicMs {$script:now}
+function Wait-AuditPoll([int]$Milliseconds) {$script:now+=$Milliseconds}
+function New-ClosureFixture {
+    Fixture
+    $script:now=100L;$script:stopped=$false;$script:stops=0;$script:captures=0;$script:disposed=0;$script:released=0
+    $script:fileCost=0;$script:captureCost=0;$script:stopCost=0;$script:sampleCost=0;$script:measureCost=0
+    $script:fileFailure=$false;$script:captureFailure=$false;$script:newMember=$false;$script:generationChange=$false
+    $script:preActive=1;$script:postActive=0;$script:postCode=0;$script:secondCaptureCost=0;$script:closeGuardCost=0
+    $script:postSampleCost=0;$script:measureBytes=0L;$script:postQueryFailure=$false
+    $script:guarded=@{};$script:closedGuards=0;$script:capturesAtStop=0;$script:stopGuards=$false
+    $script:files['C:\mock\build\fresh\build-receipt.json']=@{Image='C:\mock\build\fresh\build-receipt.json';SHA256=('a'*64);Bytes=100;Json=$script:receipt}
+    $script:compilerPath='C:\mock\VC\Tools\MSVC\14.44.35207\bin\Hostx64\x64\cl.exe'
+    $script:telemetryPath='C:\mock\VC\Tools\MSVC\14.44.35207\bin\Hostx64\x64\vctip.exe'
+    $script:files[$script:compilerPath]=@{Image=$script:compilerPath;SHA256='fe251ef50a1545b1b0835ee17b1e785459712b38d79e45b5c1d3d28970a36619';Bytes=100;Scope='ImageFileBytesUnderReadGuard'}
+    $script:files[$script:telemetryPath]=@{Image=$script:telemetryPath;SHA256='d591358c6aee4b673562ca3b3a15c250e612708394fe3b44a7a7eda2470570a5';Bytes=335288;Scope='ImageFileBytesUnderReadGuard'}
+    $script:owner=[pscustomobject]@{}
+    $script:owner|Add-Member ScriptMethod Stop {
+        $script:stops++;$script:capturesAtStop=$script:captures
+        $script:stopGuards=$script:guarded.ContainsKey($script:compilerPath) -and $script:guarded.ContainsKey($script:telemetryPath)
+        $script:stopped=$true;$script:now+=$script:stopCost
+    }
+    $script:owner|Add-Member ScriptMethod Dispose {$script:disposed++}
+    $script:record=[ordered]@{RootExitObservedMs=0L;RootExitCode=$null;JobActiveAtClose=$null;PeakObservedOutputBytes=0L;
+        OriginalIdentity=$script:context.OriginalIdentity;Success=$false;TreeClosed=$false;LeaseReleased=$false}
+}
+function Open-AuditCompletionFile([string]$Path,[long]$Maximum,[bool]$AsJson,$State,[scriptblock]$CheckClock) {
+    & $CheckClock
+    $script:now+=$script:fileCost
+    if ($script:fileFailure) {throw 'file guard unavailable'}
+    & $CheckClock
+    $full=[IO.Path]::GetFullPath($Path)
+    $script:guarded[$full]=$true;$State.Bytes+=$script:files[$full].Bytes
+    return $script:files[$full]
+}
+function Close-AuditCompletionFiles($State) {$script:closedGuards=$script:guarded.Count;$script:guarded.Clear();$script:now+=$script:closeGuardCost}
+function Get-AuditOriginalJobMembers($Owner) {
+    if (![object]::ReferenceEquals($Owner,$script:owner)) {throw 'Capture must borrow the same original owner'}
+    $script:captures++;$script:now+=$script:captureCost
+    if ($script:captures -eq 2) {$script:now+=$script:secondCaptureCost}
+    if ($script:captureFailure) {throw 'native member query failed'}
+    $created=if ($script:generationChange -and $script:captures -eq 2) {'2026-10-12T00:00:02.0000000Z'} else {'2026-10-12T00:00:01.0000000Z'}
+    $member=[ordered]@{PID=70;CreatedUtc=$created;Image=$script:telemetryPath;ParentPID=60;InOriginalJob=$true;Error=$null;ParentError=$null}
+    $members=@($member)
+    if ($script:newMember -and $script:captures -eq 2) {$members+=,[ordered]@{PID=71;CreatedUtc=$created;Image='C:\other.exe';ParentPID=70;InOriginalJob=$true}}
+    [ordered]@{CapturedUtc='2026-10-12T00:00:21.0000000Z';AssignedCount=$members.Count;ListedCount=$members.Count;Members=$members}
+}
+function Get-AuditOwnedSnapshot($Owner,[long]$StartedMs) {
+    if (![object]::ReferenceEquals($Owner,$script:owner)) {throw 'Sample must use original owner'}
+    $began=$script:now;$script:now+=$script:sampleCost
+    if ($script:stopped) {$script:now+=$script:postSampleCost}
+    if ($script:stopped -and $script:postQueryFailure) {throw 'post-Stop original handle query failed'}
+    [pscustomobject]@{ElapsedMs=$began-$StartedMs;CompletedMs=$script:now-$StartedMs;RootExited=$true;
+        RootExitCode=$(if($script:stopped){$script:postCode}else{0});Active=$(if($script:stopped){$script:postActive}else{$script:preActive})}
+}
+$measure={$script:now+=$script:measureCost;$script:measureBytes}
+function Complete {Complete-AuditBuildEvidence $script:owner $script:record 0 $script:plan $script:context $measure $true}
+New-ClosureFixture
+Complete
+Check ($script:record.QualifiedClosure.AcceptanceGranted -and $script:record.QualifiedClosure.CompletionVerified -and
+    $script:record.QualifiedClosure.ClosureVerified -and !$script:record.Success) 'Qualified closure grants no global build success itself'
+Check ($script:stops -eq 1 -and $script:capturesAtStop -eq 2 -and $script:stopGuards) 'Two real collector calls and both guards precede the sole owned Stop'
+Check ($script:closedGuards -eq 20 -and $script:guarded.Count -eq 0) 'All receipt/artifact/image guards released after post-Stop closure'
+Check (!$script:record.QualifiedClosure.Identity.CompilerAncestryProven) 'No invented compiler parent'
+New-ClosureFixture;$script:preActive=0
+Complete-AuditBuildEvidence $script:owner $script:record 0 $script:plan $script:context $measure $false
+Check ($script:stops -eq 0 -and $script:captures -eq 0 -and $script:record.QualifiedClosure.AcceptanceGranted -and
+    $script:closedGuards -eq 19) 'Natural zero closure validates identical receipt/artifact/compiler evidence without Stop'
+
+function Refuse-Closure([scriptblock]$Change,[string]$Name,[bool]$ShouldStop=$false) {
+    New-ClosureFixture;& $Change;$caught=$null
+    try {Complete} catch {$caught=$_.Exception.Message}
+    Check (![string]::IsNullOrEmpty($caught) -and !$script:record.QualifiedClosure.AcceptanceGranted) "Must refuse closure: $Name"
+    Check (($script:stops -gt 0) -eq $ShouldStop) "Stop boundary: $Name"
+    Check ($script:guarded.Count -eq 0) "Release guards after refusal: $Name"
+}
+Refuse-Closure {$script:receipt.run_id='old'} 'stale run receipt'
+Refuse-Closure {$script:receipt.steps[3].exit_code=1} 'reader step failure'
+Refuse-Closure {$script:files[$script:telemetryPath].SHA256='a'*64} 'telemetry image drift'
+Refuse-Closure {$script:files[$script:compilerPath].SHA256='a'*64} 'compiler image drift'
+Refuse-Closure {$script:fileFailure=$true} 'hash/guard failure'
+Refuse-Closure {$script:captureFailure=$true} 'native query failure'
+Refuse-Closure {$script:newMember=$true} 'additional final member'
+Refuse-Closure {$script:generationChange=$true} 'same PID new process generation'
+Refuse-Closure {$script:captureCost=1900} 'slow first member query'
+Refuse-Closure {$script:secondCaptureCost=1900} 'slow second member query'
+Refuse-Closure {$script:fileCost=1900} 'slow guarded receipt read'
+Refuse-Closure {$script:measureCost=1900} 'slow output measurement'
+Refuse-Closure {$script:sampleCost=1900} 'slow original handle getters'
+Refuse-Closure {$script:stopCost=1900} 'slow original Stop' $true
+Refuse-Closure {$script:postActive=1} 'residual did not close before deadline' $true
+Refuse-Closure {$script:postCode=1} 'root exit changed in final sample' $true
+Refuse-Closure {$script:postSampleCost=1900} 'slow post-Stop original handle query' $true
+Refuse-Closure {$script:postQueryFailure=$true} 'failed post-Stop original handle query' $true
+Refuse-Closure {$script:measureBytes=1800MB} 'output stop threshold'
+Refuse-Closure {$script:now=3600000;$script:record.RootExitObservedMs=3599999L} 'global deadline despite fresh drain'
+
+# Callback success cannot be accepted using its old nonzero sample, nor after
+# guard disposal consumes the remaining drain. Exercise actual Wait integration.
+New-ClosureFixture
+Wait-AuditOwnedBuild $script:owner $script:record 0 $measure $null {Complete}
+Check ($script:record.JobActiveAtClose -eq 0 -and $script:stops -eq 1) 'Wait obtains its own fresh zero after qualified callback'
+New-ClosureFixture;$script:closeGuardCost=1900;$caught=$null
+try {Wait-AuditOwnedBuild $script:owner $script:record 0 $measure $null {Complete}} catch {$caught=$_.Exception.Message}
+Check ($caught -match 'deadline' -and $null -eq $script:record.JobActiveAtClose) 'Slow guard disposal cannot grant late Wait closure'
+
+# Failed confirmed closure retains both original owner and lease.
+New-ClosureFixture;$script:postActive=1
+try {Complete} catch {}
+Complete-AuditOwnedCleanup $script:owner $script:record $false $measure {$script:released++}
+Check (!$script:record.TreeClosed -and !$script:record.LeaseReleased -and !$script:record.Success -and
+    $script:released -eq 0 -and $script:disposed -eq 0) 'Unconfirmed closure quarantines owner and lease'
+Check ([object]::ReferenceEquals($script:GscAuditUnclosedOwner,$script:owner)) 'Quarantine retains exact original owner'
+Write-Output "Owned closure: $script:checks checks passed; mocks only, no native load or execution."
