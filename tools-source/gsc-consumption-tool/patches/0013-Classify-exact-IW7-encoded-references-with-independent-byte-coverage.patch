+"""OPT-IN native reference controls. Requires a reviewed Plan/admission/GO.
+
+Not called by source-only tests or the existing v6 build recipe. A future reviewed
+recipe must record this phase and its artifacts before using any qualification.
+"""
+import argparse
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import unittest
+
+import references as r
+from test_references import container, literal, opcode_control
+
+ARGS = PINS = CONSUMPTION = PROFILE = TABLES = None
+
+
+class NativeReferenceTests(unittest.TestCase):
+    def call(self, raw, accepted=True):
+        self.assertEqual(r.sha(r.read(ARGS.tool, 64 * 1024 * 1024)), PINS['decoder']['tool_sha256'])
+        result = CONSUMPTION.run_bounded([str(ARGS.tool), '--stdin-gscbin-references'], raw)
+        code, output, error = result.returncode, result.stdout, result.stderr
+        self.assertEqual(r.sha(r.read(ARGS.tool, 64 * 1024 * 1024)), PINS['decoder']['tool_sha256'])
+        if not accepted:
+            self.assertNotEqual(code, 0)
+            self.assertEqual(output, b'')
+            self.assertIn(b'audit refused:', error)
+            return None
+        self.assertEqual(code, 0, error.decode(errors='replace'))
+        self.assertEqual(error, b'')
+        native = json.loads(output, object_pairs_hook=r.unique)
+        bound = r.validate(raw, native, PINS, ARGS.source_root, CONSUMPTION)
+        return native, bound
+
+    def test_all_153_opcode_controls(self):
+        for row in PROFILE['opcodes']:
+            with self.subTest(opcode=row['name']):
+                result = self.call(opcode_control(row, TABLES), row['kind'] != 'unsupported_size')
+                if result:
+                    expected = row['kind'] not in ('external_call', 'external_address', 'pointer')
+                    self.assertEqual(result[1]['encoded_external_script_reference_absence'], expected)
+
+    def test_unresolved_symbols_and_dynamic_targets_remain_blocking(self):
+        controls = [container(b'\x1b\xff\xff\x19'), container(b'\x54\x19'),
+                    container(b'\x60\0\0\0\x19', literal(b'scripts/example') + literal(b'target')),
+                    container(b'\x53\0\0\0\0\x19', b'\x80unknown\0')]
+        for raw in controls:
+            with self.subTest(raw=raw):
+                result = self.call(raw)[1]
+                self.assertFalse(result['encoded_external_script_reference_absence'])
+                self.assertTrue(result['blockers'])
+
+    def test_beacon_variant_and_original(self):
+        for role, path, digest, absent, count in [
+            ('variant', ARGS.variant, 'db486793b92e7e3c0a30c70b565fb432a4940e172a3f97da7e9db377f0e46d42', True, 570),
+            ('original', ARGS.original, '31b55a5d58a90d6b980a91543c907d26b91a4f6767d5350e8a35ae0e19fa2cef', False, 560)]:
+            with self.subTest(role=role):
+                raw = r.read(path, r.INPUT_LIMIT)
+                self.assertEqual(r.sha(raw), digest)
+                native, bound = self.call(raw)
+                self.assertEqual(bound['encoded_external_script_reference_absence'], absent)
+                self.assertEqual(bound['instruction_count'], count)
+                if role == 'original':
+                    self.assertEqual([(b['bytecode_offset'], b['stack_offset'], b['detail']['target']) for b in bound['blockers']],
+                                     [(212, 318, 'flag_exist'), (226, 345, 'flag')])
+                (ARGS.output / (role + '-native.json')).write_text(json.dumps(native, indent=2) + '\n', encoding='utf-8')
+                (ARGS.output / (role + '-bound.json')).write_text(json.dumps(bound, indent=2) + '\n', encoding='utf-8')
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    for name in ('tool', 'pins', 'source-root', 'consumption-validator', 'variant', 'original', 'output'):
+        parser.add_argument('--' + name, type=Path, required=True)
+    ARGS = parser.parse_args()
+    PINS = json.loads(r.read(ARGS.pins, 16 * 1024), object_pairs_hook=r.unique)
+    if r.sha(r.read(ARGS.consumption_validator, 1024 * 1024)) != PINS['consumption_validator_sha256']:
+        raise ValueError('Consumption module must match the independent pin before import')
+    spec = importlib.util.spec_from_file_location('consumption_native_controls', ARGS.consumption_validator)
+    CONSUMPTION = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(CONSUMPTION)
+    PROFILE, TABLES = r.load_profile(ARGS.source_root, PINS['profile_sha256'], PINS['decoder']['tables_sha256'])
+    if ARGS.output.exists():
+        raise ValueError('Use a fresh reviewed output directory')
+    ARGS.output.mkdir(parents=True)
+    unittest.main(argv=[sys.argv[0]], verbosity=2)
