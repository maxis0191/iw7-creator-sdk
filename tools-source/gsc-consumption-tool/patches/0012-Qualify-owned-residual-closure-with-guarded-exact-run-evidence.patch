diff --git a/audit/completion.ps1 b/audit/completion.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..69bd44b1c2ca4f6c4076c9fe9d0c82aaa5e68ee7
--- /dev/null
+++ b/audit/completion.ps1
@@ -0,0 +1,283 @@
+# Imported definitions only. Execution uses the admitted original owner exclusively.
+function Assert-AuditClosureClock($Record,[long]$StartedMs) {
+    $now=(Get-AuditMonotonicMs)-$StartedMs
+    if ($now -ge 3600000 -or $null -eq $Record.RootExitObservedMs -or
+        $now-$Record.RootExitObservedMs -ge 2000) { throw 'Qualified closure deadline reached' }
+}
+
+function Get-AuditByteHash([byte[]]$Bytes) {
+    [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($Bytes)).ToLowerInvariant()
+}
+
+function Assert-AuditJsonKeys($Element,[ref]$Count) {
+    $Count.Value++
+    if ($Count.Value -gt 20000) { throw 'Completion JSON node limit exceeded' }
+    if ($Element.ValueKind -eq [System.Text.Json.JsonValueKind]::Object) {
+        $seen=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
+        foreach ($property in $Element.EnumerateObject()) {
+            if (!$seen.Add($property.Name)) { throw 'Duplicate completion JSON key' }
+            Assert-AuditJsonKeys $property.Value $Count
+        }
+    } elseif ($Element.ValueKind -eq [System.Text.Json.JsonValueKind]::Array) {
+        foreach ($elementChild in $Element.EnumerateArray()) { Assert-AuditJsonKeys $elementChild $Count }
+    }
+}
+
+function Open-AuditCompletionFile([string]$Path,[long]$Maximum,[bool]$AsJson,$State,[scriptblock]$CheckClock) {
+    & $CheckClock
+    $full=[IO.Path]::GetFullPath($Path)
+    if ($State.Files.ContainsKey($full)) { return $State.Files[$full] }
+    if ($State.Guards.Count -ge 32) { throw 'Completion file count limit exceeded' }
+    $stream=[IO.File]::Open($full,'Open','Read','Read')
+    [void]$State.Guards.Add($stream) # Retained even on validation failure until owned scope unwinds.
+    & $CheckClock
+    if ($stream.Length -le 0 -or $stream.Length -gt $Maximum -or $State.Bytes+$stream.Length -gt 128MB) {
+        throw 'Completion file byte limit exceeded'
+    }
+    $hash=[Security.Cryptography.IncrementalHash]::CreateHash([Security.Cryptography.HashAlgorithmName]::SHA256)
+    $memory=if ($AsJson) {[IO.MemoryStream]::new()} else {$null}
+    try {
+        $buffer=[byte[]]::new(262144)
+        while (($read=$stream.Read($buffer,0,$buffer.Length)) -gt 0) {
+            $State.Bytes+=$read
+            if ($State.Bytes -gt 128MB) { throw 'Completion aggregate byte limit exceeded' }
+            $hash.AppendData($buffer,0,$read)
+            if ($memory) { $memory.Write($buffer,0,$read) }
+            & $CheckClock
+        }
+        $file=[ordered]@{Image=$full;Bytes=$stream.Length;
+            SHA256=[Convert]::ToHexString($hash.GetHashAndReset()).ToLowerInvariant();Scope='ImageFileBytesUnderReadGuard';Json=$null}
+        if ($AsJson) {
+            $text=[Text.UTF8Encoding]::new($false,$true).GetString($memory.ToArray()).TrimStart([char]0xfeff)
+            $doc=[System.Text.Json.JsonDocument]::Parse($text)
+            try { $nodes=0;Assert-AuditJsonKeys $doc.RootElement ([ref]$nodes) } finally { $doc.Dispose() }
+            & $CheckClock
+            $file.Json=ConvertFrom-Json -InputObject $text -AsHashtable -DateKind String -Depth 64
+        }
+        & $CheckClock
+        $State.Files[$full]=$file
+        return $file
+    } finally { $hash.Dispose();if ($memory) {$memory.Dispose()} }
+}
+
+function Close-AuditCompletionFiles($State) {
+    foreach ($guard in $State.Guards) { $guard.Dispose() }
+}
+
+function Assert-AuditSameJson($Actual,$Expected,[string]$Name) {
+    if (($Actual|ConvertTo-Json -Depth 64 -Compress) -cne ($Expected|ConvertTo-Json -Depth 64 -Compress)) {
+        throw "Completion mismatch: $Name"
+    }
+}
+function Assert-AuditDigest($Value) {
+    if ($Value -isnot [string] -or $Value -cnotmatch '^[0-9a-f]{64}$') { throw 'Complete lowercase SHA256 required' }
+}
+function ConvertTo-AuditReceiptUtc($Value) {
+    $stamp=[datetimeoffset]::MinValue
+    if ($Value -isnot [string] -or $Value -cnotmatch '^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{6,7}(Z|\+00:00)$' -or
+        ![datetimeoffset]::TryParse($Value,[Globalization.CultureInfo]::InvariantCulture,
+            [Globalization.DateTimeStyles]::None,[ref]$stamp) -or $stamp.Year -lt 2000) { throw 'Run UTC timestamp required' }
+    return $stamp
+}
+
+function Get-AuditExpectedCommands($Plan,$Source,[string]$ToolHash,[bool]$InitializeZlib) {
+    $native=Join-Path $Plan.output 'native';$tool=Join-Path $native 'Release/iw7-gsc-audit.exe'
+    $commands=[ordered]@{}
+    if ($InitializeZlib) {
+        $dependency=Join-Path $Plan.tool_root 'deps/zlib'
+        $commands['zlib-clone']=@('git','clone','--no-hardlinks','--no-checkout','--no-recurse-submodules','--',$Plan.zlib_local,$dependency)
+        $commands['zlib-checkout']=@('git','-C',$dependency,'checkout','--detach',$Plan.zlib_commit)
+    }
+    $commands['cmake-version']=@($Plan.cmake,'--version')
+    $commands['configure']=@($Plan.cmake,'-S',(Join-Path $Plan.tool_root 'audit'),'-B',$native,'-G','Visual Studio 17 2022','-A','x64',
+        ('-DAUDIT_IDENTITY_DIR='+(Join-Path $Plan.output 'identity')))
+    $commands['build']=@($Plan.cmake,'--build',$native,'--config','Release','--parallel','1','--','/m:1','/nr:false','/p:MultiProcessorCompilation=false')
+    $commands['reader-tests']=@($Plan.ctest,'--test-dir',$native,'-C','Release','--output-on-failure')
+    $commands['native-negative-tests']=@($Plan.python,'-B',(Join-Path $Plan.tool_root 'audit/test_native.py'),'--tool',$tool,'-v')
+    foreach ($item in $Plan.inputs) {
+        $commands['witness-'+$item.role]=@($Plan.python,'-B',$Plan.wrapper,'--tool',$tool,'--tool-sha256',$ToolHash,
+            '--source-revision',$Source.source_revision,'--source-sha256',$Source.source_sha256,'--tables-sha256',$Source.tables_sha256,
+            '--input',$item.path,'--output',(Join-Path $Plan.output ('witness-'+$item.role)))
+    }
+    return $commands
+}
+
+function Assert-AuditCompletionReceipt($Receipt,$Plan,$Context,[scriptblock]$ReadFile,[scriptblock]$CheckClock) {
+    & $CheckClock
+    if ($Receipt.schema -cne 'iw7.gsc-audit-build-run/2' -or $Receipt.success -isnot [bool] -or !$Receipt.success -or
+        $Receipt.failure -or $Receipt.storage_limit_exceeded -isnot [bool] -or $Receipt.storage_limit_exceeded -or
+        !(Test-AuditResidualInteger $Receipt.peak_observed_output_bytes) -or $Receipt.peak_observed_output_bytes -ge 1800MB -or
+        $Receipt.plan_sha256 -cne $Context.PlanSHA256 -or $Receipt.run_id -cne $Context.RunID -or
+        $Receipt.lease_token -cne $Context.LeaseToken -or !(Test-AuditResidualUInt32 $Receipt.root_pid) -or
+        $Receipt.root_pid -ne $Context.OriginalIdentity.PID -or !(Test-AuditResidualUInt32 $Receipt.lease_owner_pid) -or
+        $Receipt.lease_owner_pid -ne $Context.LeaseOwnerPID -or $Plan.residual_closure_policy -cne 'original-job-pinned-vctip/1') {
+        throw 'Fresh exact run/lease/plan completion receipt required'
+    }
+    Assert-AuditSameJson $Receipt.plan $Plan 'entire reviewed plan'
+    $began=ConvertTo-AuditReceiptUtc $Receipt.started_utc;$finished=ConvertTo-AuditReceiptUtc $Receipt.finished_utc
+    if ($began -lt (ConvertTo-AuditResidualUtc $Context.OriginalIdentity.CreatedUtc) -or $finished -lt $began -or
+        $finished -gt [datetimeoffset]::UtcNow) { throw 'Completion receipt time ordering differs' }
+    $source=$Receipt.build_source_manifest
+    if ($source.schema -cne 'iw7.gsc-audit-build-source/2' -or $source.source_revision -cne $Plan.source_revision -or
+        $source.tool_source_sha256 -cne $Plan.tool_source_sha256 -or $source.tables_sha256 -cne $Plan.tables_sha256 -or
+        $source.zlib_commit -cne $Plan.zlib_commit -or $source.dependencies_materialized -isnot [bool] -or
+        !$source.dependencies_materialized) { throw 'Bound source/dependency manifest required' }
+    Assert-AuditDigest $source.source_sha256;Assert-AuditDigest $source.zlib_source_sha256;Assert-AuditDigest $Receipt.tool_sha256
+    $combined='{"tool":"'+$source.tool_source_sha256+'","zlib":"'+$source.zlib_source_sha256+'","zlib_commit":"'+$source.zlib_commit+'"}'
+    if ((Get-AuditByteHash ([Text.Encoding]::UTF8.GetBytes($combined))) -cne $source.source_sha256) { throw 'Combined source digest differs' }
+    if (@($Plan.inputs).Count -ne 2 -or $Plan.inputs[0].role -cne 'variant' -or $Plan.inputs[1].role -cne 'original') {
+        throw 'Exactly ordered variant/original inputs required'
+    }
+    $compilers=@($Receipt.compilers)
+    if ($compilers.Count -ne 1 -or $compilers[0].compiler_sha256 -cne 'fe251ef50a1545b1b0835ee17b1e785459712b38d79e45b5c1d3d28970a36619') {
+        throw 'Exactly one pinned configured compiler required'
+    }
+    $compiler=$compilers[0];$native=[IO.Path]::GetFullPath((Join-Path $Plan.output 'native'))
+    if ($compiler.compiler -isnot [string] -or ![IO.Path]::IsPathFullyQualified($compiler.compiler) -or
+        [IO.Path]::GetFullPath($compiler.compiler) -notmatch '\\VC\\Tools\\MSVC\\14\.44\.35207\\bin\\Hostx64\\x64\\cl\.exe$') {
+        throw 'Pinned configured compiler path required'
+    }
+    $config=[IO.Path]::GetFullPath($compiler.configuration)
+    if (!$config.StartsWith($native+[IO.Path]::DirectorySeparatorChar,[StringComparison]::OrdinalIgnoreCase) -or
+        [IO.Path]::GetFileName($config) -cne 'CMakeCXXCompiler.cmake') { throw 'Compiler configuration escaped run output' }
+    Assert-AuditDigest $compiler.configuration_sha256
+    $commands=Get-AuditExpectedCommands $Plan $source $Receipt.tool_sha256 ($Receipt.steps[0].name -ceq 'zlib-clone')
+    $steps=@($Receipt.steps)
+    if ($steps.Count -ne $commands.Count) { throw 'Incomplete or duplicate completion steps' }
+    $expected=[ordered]@{'source-manifest'=(Join-Path $Plan.output 'identity/source-manifest.json');
+        'tool'=(Join-Path $native 'Release/iw7-gsc-audit.exe');'wrapper'=$Plan.wrapper;'compiler-config-0'=$config}
+    $lastCreated=$began;$index=0
+    foreach ($name in $commands.Keys) {
+        $step=$steps[$index++];$created=ConvertTo-AuditReceiptUtc $step.creation_utc
+        if ($step.name -cne $name -or !(Test-AuditResidualInteger $step.exit_code) -or $step.exit_code -ne 0 -or
+            !(Test-AuditResidualInteger $step.wrapper_exit_code) -or $step.wrapper_exit_code -ne 0 -or
+            $step.failure -or $step.storage_limit_exceeded -isnot [bool] -or $step.storage_limit_exceeded -or
+            !(Test-AuditResidualUInt32 $step.pid) -or $created -lt $lastCreated -or $created -gt $finished -or
+            !(Test-AuditResidualInteger $step.peak_output_bytes) -or $step.peak_output_bytes -ge 1800MB) {
+            throw 'Ordered successful bounded steps required'
+        }
+        $lastCreated=$created
+        Assert-AuditSameJson @($step.command) @($commands[$name]) ('command '+$name)
+        $expected['result-'+$name]=Join-Path $Plan.output ($name+'.result.json')
+    }
+    foreach ($input in $Plan.inputs) {
+        $expected['input-'+$input.role]=$input.path
+        $expected['witness-'+$input.role]=Join-Path $Plan.output ('witness-'+$input.role+'/consumption.json')
+        $expected['assembly-'+$input.role]=Join-Path $Plan.output ('witness-'+$input.role+'/disassembly.gscasm')
+    }
+    $artifacts=@($Receipt.completion_artifacts);$files=@{};$seen=[Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
+    if ($artifacts.Count -ne $expected.Count) { throw 'Complete bounded artifact set required' }
+    foreach ($artifact in $artifacts) {
+        if ($artifact.role -isnot [string] -or !$expected.Contains($artifact.role) -or !$seen.Add($artifact.role) -or
+            [IO.Path]::GetFullPath($artifact.path) -ine [IO.Path]::GetFullPath($expected[$artifact.role]) -or
+            !(Test-AuditResidualUInt32 $artifact.bytes)) { throw 'Exact unique artifact scope required' }
