{
  "schema": "iw7.gamelab-plan/1",
  "name": "sz_oneway_core",
  "map": "cp_zmb",
  "conditions": "quiet",
  "libraries": ["cp_sz_oneway", "szoneway_driver"],
  "about": "ONE WAY, the mechanic on a stock stand-in weapon (iw7_fhr_zm), headless on cp_zmb: tickets issued by real bullets through the stock damage callback (the weapon's hook returns 0 damage and books the zombie), the 6 s beat of the match's own clock, flat rated damage at the bell, taken and carried, six carried a bell, put back, the 12 s rule, the head ticket, the wasted fourth ticket, the doors-closing half second, the full-train refund. Conditions on purpose: stock spawning off, zombies ignore the bot, no rounds played (health by the stock formula of the named round), one engine bot. Run with: forge run <this> --library-dir <tools-source/iwzmap/weapons/one_way>.",
  "steps": [
    {"do": "waves", "on": false},
    {"do": "ignore", "on": true},
    {"do": "tp", "at": [1467.65, 4134.45, 0.2], "yaw": 0},
    {"do": "give", "weapon": "iw7_fhr_zm"},
    {"do": "ammo", "clip": 30, "stock": 10},
    {"do": "call", "fn": "owt_start", "args": ["start", "iw7_fhr", 0], "s": 1},

    {"do": "spawn", "tag": "a", "at": [1767, 4134, 0], "count": 12, "round": 10},
    {"do": "until", "what": "alive", "n": 12, "s": 20},
    {"do": "call", "fn": "owt_stat", "args": ["a0_stat"], "s": 1},
    {"do": "call", "fn": "owt_case", "args": ["a", "a", 1, 0, 0, 5000], "s": 14},
    {"do": "kill", "tag": "a"},

    {"do": "spawn", "tag": "b", "at": [1767, 4134, 0], "count": 8, "round": 25},
    {"do": "until", "what": "alive", "n": 8, "s": 20},
    {"do": "call", "fn": "owt_case", "args": ["b", "b", 1, 0, 0, 5000], "s": 14},
    {"do": "call", "fn": "owt_after", "args": ["b2", "b"], "s": 8},
    {"do": "call", "fn": "owt_case", "args": ["b3", "b", 1, 0, 0, 5000], "s": 14},
    {"do": "kill", "tag": "b"},

    {"do": "spawn", "tag": "c", "at": [1767, 4134, 0], "count": 1, "round": 33},
    {"do": "until", "what": "alive", "n": 1, "s": 20},
    {"do": "call", "fn": "owt_case", "args": ["c", "c", 1, 1, 0, 3000], "s": 12},
    {"do": "kill", "tag": "c"},

    {"do": "spawn", "tag": "d", "at": [1767, 4134, 0], "count": 1, "round": 34},
    {"do": "until", "what": "alive", "n": 1, "s": 20},
    {"do": "call", "fn": "owt_case", "args": ["d", "d", 1, 1, 0, 3000], "s": 12},
    {"do": "call", "fn": "owt_after", "args": ["d2", "d"], "s": 8},
    {"do": "kill", "tag": "d"},

    {"do": "spawn", "tag": "e", "at": [1767, 4134, 0], "count": 1, "round": 35},
    {"do": "until", "what": "alive", "n": 1, "s": 20},
    {"do": "call", "fn": "owt_case", "args": ["e", "e", 4, 0, 0, 5000], "s": 14},
    {"do": "kill", "tag": "e"},

    {"do": "spawn", "tag": "f", "at": [1767, 4134, 0], "count": 1, "round": 10},
    {"do": "until", "what": "alive", "n": 1, "s": 20},
    {"do": "call", "fn": "owt_case", "args": ["f", "f", 1, 0, 0, 400], "s": 9},
    {"do": "call", "fn": "owt_after", "args": ["f2", "f"], "s": 8},
    {"do": "kill", "tag": "f"},

    {"do": "expect", "that": "probe:start.hooked", "eq": 1, "why": "the stock zombie damage callback has the weapon's hook"},
    {"do": "expect", "that": "spawn:a.health", "eq": 1045, "why": "round 10 health by the stock formula"},
    {"do": "expect", "that": "probe:a_issue.issued", "eq": 12, "why": "twelve real bullets through the stock callback are twelve tickets"},
    {"do": "expect", "that": "probe:a_booked.alive", "eq": 12, "why": "a ticket does no damage: all twelve stand booked before the bell"},
    {"do": "expect", "that": "probe:a_booked.hmin", "eq": 1045, "why": "a ticket takes no health"},
    {"do": "expect", "that": "probe:a_booked.tickets", "eq": 12, "why": "one ticket each"},
    {"do": "expect", "that": "probe:a_stat.taken", "eq": 12, "why": "one second-class ticket (3,970) covers a round-10 zombie: all taken on one bell"},
    {"do": "expect", "that": "probe:a_z.alive", "eq": 0, "why": "taken is a kill"},
    {"do": "expect", "that": "probe:a_stat.full", "eq": 1, "why": "twelve taken on one bell is a full train"},
    {"do": "expect", "that": "probe:a_stat.refund", "eq": 6, "why": "one ticket back for two taken"},
    {"do": "expect", "that": "probe:a_stat.stock", "eq": 16, "why": "the refund reached the reserve: 10 + 6"},
    {"do": "expect", "that": "probe:a_stat.money", "gt": "@probe:a0_stat.money", "why": "kills at the bell pay the owner"},

    {"do": "expect", "that": "probe:b_stat.taken", "eq": 12, "why": "one second-class ticket does not cover a round-25 zombie (4,365)"},
    {"do": "expect", "that": "probe:b_stat.carried", "eq": 6, "why": "six cars: six carried on one bell"},
    {"do": "expect", "that": "probe:b_stat.stayed", "eq": 2, "why": "the two others take the damage and stay"},
    {"do": "expect", "that": "probe:b_z.alive", "eq": 8, "why": "carried and stayed are alive"},
    {"do": "expect", "that": "probe:b_z.carried", "eq": 6, "why": "six are off the platform"},
    {"do": "expect", "that": "probe:b_z.hmax", "near": 395, "tol": 2, "why": "flat damage: 4,365 - 3,970, whatever the callback's multipliers"},
    {"do": "expect", "that": "probe:b_z.hmin", "near": 395, "tol": 2, "why": "the same for every one"},
    {"do": "expect", "that": "probe:b2_z.carried", "eq": 0, "why": "put back at the next bell"},
    {"do": "expect", "that": "probe:b2_z.alive", "eq": 8, "why": "all eight back on the platform"},
    {"do": "expect", "that": "probe:b2_z.immune", "eq": 6, "why": "the six put back are under the 12 s rule"},
    {"do": "expect", "that": "probe:b3_stat.taken", "eq": 20, "why": "a second ticket covers the 395 left: eight more taken"},
    {"do": "expect", "that": "probe:b3_stat.refund", "eq": 10, "why": "eight taken: four back"},

    {"do": "expect", "that": "probe:c_stat.first", "eq": 1, "why": "a bullet in the head is a first-class ticket"},
    {"do": "expect", "that": "probe:c_stat.taken", "eq": 21, "why": "one first-class ticket (9,920) covers round 33 (9,357)"},
    {"do": "expect", "that": "probe:d_stat.taken", "eq": 21, "why": "and not round 34 (10,293)"},
    {"do": "expect", "that": "probe:d_stat.carried", "eq": 7, "why": "it is carried one stop"},
    {"do": "expect", "that": "probe:d_z.hmax", "near": 373, "tol": 2, "why": "10,293 - 9,920"},
    {"do": "expect", "that": "probe:d2_z.carried", "eq": 0, "why": "and put back"},

    {"do": "expect", "that": "probe:e_stat.wasted", "eq": 1, "why": "a zombie holds three tickets: the fourth is spent for nothing"},
    {"do": "expect", "that": "probe:e_stat.taken", "eq": 22, "why": "three second-class (11,910) cover round 35 (11,322)"},

    {"do": "expect", "that": "probe:f_issue.issued", "eq": 1, "why": "a ticket in the last half second is issued"},
    {"do": "expect", "that": "probe:f_stat.taken", "eq": 22, "why": "and is not valid for the bell that follows at once"},
    {"do": "expect", "that": "probe:f_z.booked", "eq": 1, "why": "it is still booked"},
    {"do": "expect", "that": "probe:f2_stat.taken", "eq": 23, "why": "it is taken at the bell after"}
  ]
}
