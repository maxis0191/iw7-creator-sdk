+function Refuse([scriptblock]$Action,[string]$Pattern) {
+    $message=$null
+    try { & $Action } catch { $message=$_.Exception.Message }
+    Assert-Check ($message -match $Pattern) "Expected '$Pattern', got '$message'"
+}
+function Get-AuditMonotonicMs { $script:fixture.Now }
+function Wait-AuditPoll([int]$Milliseconds) { $script:fixture.Now+=$Milliseconds }
+function New-Fixture {
+    $script:fixture=[pscustomobject]@{Now=0L;Calls=0;Unavailable=0;Error=$null;RegisterCost=0L;
+        ExitDuringCall=$false;StopFailure=$false;Stops=0;Disposes=0;Releases=0;MeasureCost=0L}
+    $owner=[pscustomobject]@{PID=77;Image='C:\audit\python.exe';CreatedUtc='2026-10-12T06:00:00.0000000Z';
+        Priority=0x4000;Resumed=$false;Exited=$false;Active=1;ExitCode=0}
