 Illustrative commands, to execute only inside the admitted job after step 2:
 
+The reproducible entry point is `audit/build.ps1 -Plan PLAN_JSON -PlanSha256 HASH`.
+Its default only displays the plan. `-Execute` is the explicit coordinator action:
+it acquires `Invoke-IW7ResourceJob` before initializing zlib or starting any build.
+`audit/build.py` generates the plan from exact source/SDK revisions, input hashes,
+tool/wrapper/scheduler hashes and absolute output roots. Its execution mode requires
+the parent scheduler's lease token and owner PID. The child runner retains a .NET
+Process object and closes only its own process tree on timeout/storage failure;
+stdout/stderr stream to files instead of accumulating in memory. Commands, process
+identities, exit codes, compiler identity, source/dependency manifests, tool hash,
+storage observations and both Beacon consumption receipts remain in the ignored
+output directory. Source and dependency bytes are checked again after all steps.
+
 ```text
 python -B audit/prepare.py --output build/identity-reviewed
 cmake -S audit -B build/audit-native -G "Visual Studio 17 2022" -A x64 -DAUDIT_IDENTITY_DIR=ABSOLUTE_IDENTITY_DIRECTORY
diff --git a/audit/build.ps1 b/audit/build.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..36c04675cf62bebbad52ce8f308eb33f058af33c
--- /dev/null
+++ b/audit/build.ps1
@@ -0,0 +1,44 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][string]$Plan,
+    [Parameter(Mandatory)][string]$PlanSha256,
+    [switch]$Execute
+)
+$ErrorActionPreference = 'Stop'
+$planPath = (Resolve-Path -LiteralPath $Plan).Path
+$planBytes = [IO.File]::ReadAllBytes($planPath)
+if ($planBytes.Length -gt 1MB) { throw 'Build plan exceeds size limit' }
+$hasher = [Security.Cryptography.SHA256]::Create()
+try { $actualHash = [Convert]::ToHexString($hasher.ComputeHash($planBytes)).ToLowerInvariant() } finally { $hasher.Dispose() }
+if ($actualHash -ne $PlanSha256.ToLowerInvariant()) {
+    throw 'Reviewed build plan hash mismatch'
+}
+$planData = [Text.Encoding]::UTF8.GetString($planBytes) | ConvertFrom-Json
+$repo = (Resolve-Path -LiteralPath (Join-Path $PSScriptRoot '..')).Path
+if ($planData.tool_root -ne $repo -or $planData.physical_bytes -ne 4GB -or $planData.commit_bytes -ne 6GB -or
+    $planData.output_limit_bytes -ne 2GB) { throw 'Build plan scope or budget mismatch' }
+if (-not $Execute) {
+    $planData | ConvertTo-Json -Depth 12
+    return
+}
+# The coordinator must explicitly admit this execution; no initialization occurs
+# before the reviewed account-wide scheduler acquires the heavy-workload slot.
+$scheduler = (Resolve-Path -LiteralPath $planData.scheduler).Path
+if ((Get-FileHash -LiteralPath $scheduler -Algorithm SHA256).Hash.ToLowerInvariant() -ne $planData.scheduler_sha256) {
+    throw 'Reviewed scheduler changed'
+}
+. $scheduler
+Invoke-IW7ResourceJob -Scope $repo -Kind Build -PhysicalBytes 4GB -CommitBytes 6GB -Owner 'strict IW7 GSC audit build' -Body {
+    if (-not $lease.Token) { throw 'Scheduler did not expose the acquired lease token' }
+    $previousOwner = $env:IW7_GSC_AUDIT_LEASE_OWNER
+    $previousToken = $env:IW7_GSC_AUDIT_LEASE_TOKEN
+    try {
+        $env:IW7_GSC_AUDIT_LEASE_OWNER = [string]$PID
+        $env:IW7_GSC_AUDIT_LEASE_TOKEN = [string]$lease.Token
+        & $planData.python -B (Join-Path $PSScriptRoot 'build.py') --plan $planPath --plan-sha256 $PlanSha256 --execute
+        if ($LASTEXITCODE -ne 0) { throw "GSC audit build/test failed with exit $LASTEXITCODE; retain receipt and logs" }
+    } finally {
+        $env:IW7_GSC_AUDIT_LEASE_OWNER = $previousOwner
+        $env:IW7_GSC_AUDIT_LEASE_TOKEN = $previousToken
+    }
+}
diff --git a/audit/build.py b/audit/build.py
new file mode 100644
index 0000000000000000000000000000000000000000..a3d94beebda47d6a052ffd71729606a2f129c9e5
--- /dev/null
+++ b/audit/build.py
@@ -0,0 +1,199 @@
+"""Plan or execute a pinned build; execution belongs inside build.ps1's resource lease."""
+import argparse
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import re
+import subprocess
+import sys
+
+import prepare
+
+ROOT = prepare.ROOT
+GIB = 1024 ** 3
+
+
+def sha_file(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def size(path):
+    return sum(p.stat().st_size for p in path.rglob('*') if p.is_file()) if path.exists() else 0
+
+
+def plan(args):
+    source = prepare.inspect_sources(require_zlib=False)
+    sdk = args.sdk_root.resolve(strict=True)
+    zlib = args.zlib_local.resolve(strict=True)
+    if prepare.git('rev-parse', 'HEAD', root=zlib) != source['zlib_commit'] or prepare.git('status', '--porcelain', root=zlib):
+        raise ValueError('Local zlib source must match the exact clean gitlink')
+    wrapper = sdk / 'sdk/modding/audit_gsc_consumption.py'
+    if prepare.git('status', '--porcelain', '--', str(wrapper), root=sdk):
+        raise ValueError('SDK wrapper has uncommitted edits')
+    output = args.output.resolve()
+    if output.exists() or not output.is_relative_to(ROOT / 'build'):
+        raise ValueError('Use a fresh build output root under build/')
+    inputs = []
+    for role, path in (('variant', args.variant), ('original', args.original)):
+        path = path.resolve(strict=True)
+        inputs.append({'role': role, 'path': str(path), 'sha256': sha_file(path), 'bytes': path.stat().st_size})
+    scheduler = args.scheduler.resolve(strict=True)
+    cmake = args.cmake.resolve(strict=True)
+    ctest = cmake.with_name('ctest.exe')
+    pwsh = Path(shutil.which('pwsh')).resolve(strict=True)
+    return {'schema': 'iw7.gsc-audit-build-plan/1', 'tool_root': str(ROOT),
+            'source_revision': source['source_revision'], 'tool_source_sha256': source['tool_source_sha256'],
+            'tables_sha256': source['tables_sha256'], 'zlib_commit': source['zlib_commit'],
+            'zlib_local': str(zlib), 'sdk_root': str(sdk), 'sdk_revision': prepare.git('rev-parse', 'HEAD', root=sdk),
+            'wrapper': str(wrapper), 'wrapper_sha256': sha_file(wrapper),
+            'scheduler': str(scheduler), 'scheduler_sha256': sha_file(scheduler),
+            'python': sys.executable, 'python_sha256': sha_file(sys.executable),
+            'pwsh': str(pwsh), 'pwsh_sha256': sha_file(pwsh),
+            'cmake': str(cmake), 'cmake_sha256': sha_file(cmake), 'ctest': str(ctest), 'ctest_sha256': sha_file(ctest),
+            'output': str(output), 'inputs': inputs, 'physical_bytes': 4 * GIB, 'commit_bytes': 6 * GIB,
+            'output_limit_bytes': 2 * GIB, 'output_stop_threshold_bytes': 1800 * 1024 ** 2,
+            'storage_poll_seconds': 0.25, 'build_nodes': 1, 'source_preparation_limit_bytes': 128 * 1024 ** 2,
+            'native_executed': False}
+
+
+def validate_plan(plan):
+    source = prepare.inspect_sources(require_zlib=False)
+    for key in ('source_revision', 'tool_source_sha256', 'tables_sha256', 'zlib_commit'):
+        if plan[key] != source[key]:
+            raise ValueError('Reviewed source plan changed: ' + key)
+    if Path(plan['tool_root']).resolve() != ROOT or plan['physical_bytes'] != 4 * GIB or plan['commit_bytes'] != 6 * GIB:
+        raise ValueError('Plan scope or admission budget differs')
+    if prepare.git('rev-parse', 'HEAD', root=Path(plan['sdk_root'])) != plan['sdk_revision']:
+        raise ValueError('Reviewed SDK revision changed')
+    for key in ('python', 'pwsh', 'cmake', 'ctest', 'scheduler', 'wrapper'):
+        if sha_file(plan[key]) != plan[key + '_sha256']:
+            raise ValueError('Reviewed executable/source changed: ' + key)
+    for item in plan['inputs']:
+        if sha_file(item['path']) != item['sha256']:
+            raise ValueError('Recorded GSC input changed')
+    output = Path(plan['output']).resolve()
+    if not output.is_relative_to(ROOT / 'build') or output.exists():
+        raise ValueError('Fresh ignored output root required')
+    if plan['output_limit_bytes'] != 2 * GIB or plan['output_stop_threshold_bytes'] != 1800 * 1024 ** 2:
+        raise ValueError('Storage guard differs')
+    if shutil.disk_usage(ROOT).free < 2 * GIB + 128 * 1024 ** 2:
+        raise ValueError('Insufficient disk space for declared output/source allowance')
+
+
+def execute(plan):
+    if os.environ.get('IW7_GSC_AUDIT_LEASE_OWNER') != str(os.getppid()) or not os.environ.get('IW7_GSC_AUDIT_LEASE_TOKEN'):
+        raise ValueError('Invoke through build.ps1 inside its admitted resource job')
+    validate_plan(plan)
+    output = Path(plan['output'])
+    output.mkdir(parents=True)
+    receipt = {'schema': 'iw7.gsc-audit-build-run/1', 'plan': plan, 'steps': [],
+               'lease_token': os.environ['IW7_GSC_AUDIT_LEASE_TOKEN'],
+               'lease_owner_pid': int(os.environ['IW7_GSC_AUDIT_LEASE_OWNER']),
+               'started_utc': datetime.now(timezone.utc).isoformat(), 'success': False,
+               'peak_observed_output_bytes': 0, 'storage_limit_exceeded': False,
+               'storage_guard': 'polling stop at 1800 MiB; not an OS disk quota'}
+
+    def save():
+        (output / 'build-receipt.json').write_text(json.dumps(receipt, indent=2) + '\n', encoding='utf-8')
+
+    def run(name, command, timeout=1800):
+        stdout, stderr = output / (name + '.stdout.log'), output / (name + '.stderr.log')
+        specification = {'command': [str(value) for value in command], 'cwd': str(ROOT), 'output_root': str(output),
+                         'stdout': str(stdout), 'stderr': str(stderr), 'result': str(output / (name + '.result.json')),
+                         'timeout_seconds': timeout, 'stop_bytes': plan['output_stop_threshold_bytes'],
+                         'limit_bytes': plan['output_limit_bytes']}
+        spec_path = output / (name + '.command.json')
+        spec_path.write_text(json.dumps(specification), encoding='utf-8')
+        result = subprocess.run([plan['pwsh'], '-NoProfile', '-NonInteractive', '-File', str(ROOT / 'audit/run_process.ps1'),
+                                 '-Spec', str(spec_path)], cwd=ROOT, creationflags=subprocess.CREATE_NO_WINDOW)
+        step = json.loads(Path(specification['result']).read_text(encoding='utf-8-sig'))
+        step['name'] = name
+        receipt['steps'].append(step)
+        receipt['peak_observed_output_bytes'] = max(receipt['peak_observed_output_bytes'], step['peak_output_bytes'])
+        receipt['storage_limit_exceeded'] |= step['storage_limit_exceeded']
+        save()
+        if result.returncode or receipt['storage_limit_exceeded']:
+            raise RuntimeError('Build step failed: ' + name)
+
+    try:
+        dependency = ROOT / 'deps/zlib'
+        local = Path(plan['zlib_local'])
+        if prepare.git('rev-parse', 'HEAD', root=local) != plan['zlib_commit'] or prepare.git('status', '--porcelain', root=local):
+            raise ValueError('Local zlib identity changed before initialization')
+        if not (dependency / '.git').exists():
+            if dependency.exists() and any(dependency.iterdir()):
+                raise ValueError('Unowned zlib contents')
+            run('zlib-clone', ['git', 'clone', '--no-hardlinks', '--no-checkout', '--no-recurse-submodules', '--', str(local), str(dependency)])
+            run('zlib-checkout', ['git', '-C', str(dependency), 'checkout', '--detach', plan['zlib_commit']])
+        if size(ROOT) - size(ROOT / 'build') > plan['source_preparation_limit_bytes']:
+            raise ValueError('Source preparation exceeded 128 MiB; retain files for review')
+        identity = output / 'identity'
+        source = prepare.prepare(identity)
+        if source['tool_source_sha256'] != plan['tool_source_sha256'] or source['tables_sha256'] != plan['tables_sha256']:
+            raise ValueError('Source identity changed during zlib initialization')
+        receipt['build_source_manifest'] = source
+        run('cmake-version', [plan['cmake'], '--version'])
+        native = output / 'native'
+        run('configure', [plan['cmake'], '-S', str(ROOT / 'audit'), '-B', str(native), '-G', 'Visual Studio 17 2022',
+                          '-A', 'x64', '-DAUDIT_IDENTITY_DIR=' + str(identity)])
+        compiler_records = []
+        for compiler_file in native.rglob('CMakeCXXCompiler.cmake'):
+            match = re.search(r'set\(CMAKE_CXX_COMPILER "([^"]+)"\)', compiler_file.read_text())
+            if not match:
+                raise ValueError('Configured compiler identity unavailable')
+            compiler_records.append({'configuration_sha256': sha_file(compiler_file),
+                                     'compiler': match.group(1), 'compiler_sha256': sha_file(match.group(1))})
+        if not compiler_records:
+            raise ValueError('No configured compiler record')
+        receipt['compilers'] = compiler_records
+        run('build', [plan['cmake'], '--build', str(native), '--config', 'Release', '--parallel', '1', '--',
+                      '/m:1', '/nr:false', '/p:MultiProcessorCompilation=false'])
+        run('reader-tests', [plan['ctest'], '--test-dir', str(native), '-C', 'Release', '--output-on-failure'])
+        tool = native / 'Release/iw7-gsc-audit.exe'
+        tool_hash = sha_file(tool)
+        receipt['tool_sha256'] = tool_hash
+        run('native-negative-tests', [plan['python'], '-B', str(ROOT / 'audit/test_native.py'), '--tool', str(tool), '-v'], 120)
+        for item in plan['inputs']:
+            if sha_file(item['path']) != item['sha256']:
+                raise ValueError('GSC input changed before witness run')
+            run('witness-' + item['role'], [plan['python'], '-B', plan['wrapper'], '--tool', str(tool), '--tool-sha256', tool_hash,
+                '--source-revision', source['source_revision'], '--source-sha256', source['source_sha256'],
+                '--tables-sha256', source['tables_sha256'], '--input', item['path'], '--output', str(output / ('witness-' + item['role']))], 90)
+        final_source = prepare.inspect_sources(require_zlib=True)
+        if final_source != source or sha_file(tool) != tool_hash or sha_file(plan['wrapper']) != plan['wrapper_sha256']:
+            raise ValueError('Source/dependency/tool/wrapper changed during build validation')
+        if any(sha_file(record['compiler']) != record['compiler_sha256'] for record in compiler_records):
+            raise ValueError('Compiler changed during build')
+        receipt['success'] = True
+    except Exception as error:
+        receipt['failure'] = str(error)
+        raise
+    finally:
+        receipt['finished_utc'] = datetime.now(timezone.utc).isoformat()
+        save()
+    return receipt
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--plan', type=Path)
+    parser.add_argument('--plan-sha256')
+    parser.add_argument('--execute', action='store_true')
+    parser.add_argument('--sdk-root', type=Path)
+    parser.add_argument('--zlib-local', type=Path)
+    parser.add_argument('--cmake', type=Path)
+    parser.add_argument('--scheduler', type=Path)
+    parser.add_argument('--variant', type=Path)
+    parser.add_argument('--original', type=Path)
+    parser.add_argument('--output', type=Path)
+    args = parser.parse_args()
+    if args.execute:
+        raw = args.plan.read_bytes()
+        if hashlib.sha256(raw).hexdigest() != args.plan_sha256:
+            raise ValueError('Reviewed plan digest differs')
+        execute(json.loads(raw))
+    else:
+        print(json.dumps(plan(args), indent=2))
