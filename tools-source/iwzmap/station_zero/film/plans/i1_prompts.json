{
 "schema": "iw7.gamelab-plan/1",
 "name": "i1_prompts",
 "map": "cp_iwz",
 "conditions": "quiet",
 "libraries": [
  "szaccept",
  "szi1"
 ],
 "about": "I1 (29 Nov), real time, a client: the D4 prompt from the ticket hall, D4 bought from there (no teleport), the hall and the Arcade read after the purchase; the marksman prompt from the hall at the Heel & Key counter front, the rifle bought from there.",
 "steps": [
  {
   "do": "waves",
   "on": false
  },
  {
   "do": "call",
   "fn": "sz_power_direct",
   "args": [
    "power",
    20
   ],
   "s": 1
  },
  {
   "do": "wait",
   "s": 6
  },
  {
   "do": "money",
   "value": 20000
  },
  {
   "do": "tp",
   "at": [
    -1080,
    3900,
    1
   ],
   "yaw": 180
  },
  {
   "do": "look",
   "yaw": 180,
   "pitch": 5
  },
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "ui",
   "name": "d4_before"
  },
  {
   "do": "capture",
   "name": "i1_d4_before",
   "pause": 2
  },
  {
   "do": "call",
   "fn": "i1_buy",
   "args": [
    "d4",
    "debris_1000",
    -1160.0,
    3900.0,
    24.0,
    2
   ],
   "s": 6
  },
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "ui",
   "name": "d4_after_hall"
  },
  {
   "do": "capture",
   "name": "i1_d4_after_hall",
   "pause": 2
  },
  {
   "do": "tp",
   "at": [
    -1296,
    3880,
    1
   ],
   "yaw": 172
  },
  {
   "do": "look",
   "yaw": 172,
   "pitch": 0
  },
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "ui",
   "name": "d4_after_arcade"
  },
  {
   "do": "capture",
   "name": "i1_d4_after_arcade",
   "pause": 2
  },
  {
   "do": "tp",
   "at": [
    -1490,
    4285,
    1
   ],
   "yaw": 90
  },
  {
   "do": "look",
   "yaw": 90,
   "pitch": 5
  },
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "ui",
   "name": "mk_before"
  },
  {
   "do": "capture",
   "name": "i1_mk_before",
   "pause": 2
  },
  {
   "do": "call",
   "fn": "i1_buy",
   "args": [
    "mk",
    "iw7_m1c_zm",
    -1490.0,
    4336.0,
    64.0,
    2
   ],
   "s": 6
  },
  {
   "do": "wait",
   "s": 1
  },
  {
   "do": "capture",
   "name": "i1_mk_after",
   "pause": 2
  },
  {
   "do": "expect",
   "that": "probe:d4.found",
   "why": "D4 on a client: the stock interaction is there",
   "eq": 1
  },
  {
   "do": "expect",
   "that": "probe:d4.d",
   "why": "D4 on a client: bought from where a player stands, outside the monitor 75",
   "gt": 75
  },
  {
   "do": "expect",
   "that": "probe:d4.route",
   "why": "D4 on a client: the stock monitor offers it from there (not refused)",
   "ne": "refused_within_75"
  },
  {
   "do": "expect",
   "that": "probe:d4.spent",
   "why": "D4 on a client: the price",
   "eq": 1000
  },
  {
   "do": "expect",
   "that": "probe:mk.found",
   "why": "the marksman rifle on a client: the stock interaction is there",
   "eq": 1
  },
  {
   "do": "expect",
   "that": "probe:mk.d",
   "why": "the marksman rifle on a client: bought from where a player stands, outside the monitor 75",
   "gt": 75
  },
  {
   "do": "expect",
   "that": "probe:mk.route",
   "why": "the marksman rifle on a client: the stock monitor offers it from there (not refused)",
   "ne": "refused_within_75"
  },
  {
   "do": "expect",
   "that": "probe:mk.spent",
   "why": "the marksman rifle on a client: the price",
   "eq": 1500
  },
  {
   "do": "expect",
   "that": "probe:d4.hint",
   "why": "the stock monitor itself offered D4 (the prompt showed)",
   "eq": 1
  },
  {
   "do": "expect",
   "that": "probe:mk.hint",
   "why": "the stock monitor itself offered the rifle (the prompt showed)",
   "eq": 1
  },
  {
   "do": "expect",
   "that": "probe:mk.has",
   "why": "the client holds the marksman rifle",
   "eq": 1
  }
 ]
}