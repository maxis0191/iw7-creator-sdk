+"""Read-only, independently decoded IW7 encoded-reference qualification.
+
+No subprocess, network, native execution, package operation, or runtime claim.
+The caller supplies independently trusted pins and the existing pure consumption
+validator. A report is evidence content, not authentication of an execution.
+"""
+import hashlib
+import json
+from pathlib import Path
+import re
+import struct
+import zlib
+
+ROOT = Path(__file__).resolve().parent
+INPUT_LIMIT = 8 * 1024 * 1024
+STACK_LIMIT = 16 * 1024 * 1024
+REPORT_LIMIT = 64 * 1024 * 1024
+KINDS = frozenset('plain scalar slot field string animation animtree pointer local_address local_call '
+                  'external_address external_call builtin_function_address builtin_method_address '
+                  'builtin_function builtin_method branch_i16 branch_back_u16 branch_i32 switch '
+                  'switch_table unsupported_size'.split())
+TABLE_PATHS = frozenset(['src/gsc/engine/iw7.cpp', 'src/gsc/engine/iw7_code.cpp',
+    'src/gsc/engine/iw7_func.cpp', 'src/gsc/engine/iw7_meth.cpp', 'src/gsc/engine/iw7_token.cpp',
+    'include/xsk/gsc/engine/iw7.hpp', 'include/xsk/gsc/common/assembly.hpp', 'src/gsc/context.cpp'])
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def unique(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError('Duplicate JSON key: ' + key)
+        result[key] = value
+    return result
+
+
+def read(path, limit):
+    with Path(path).open('rb') as stream:
+        raw = stream.read(limit + 1)
+    if len(raw) > limit:
+        raise ValueError('File exceeds reference reader limit')
+    return raw
+
+
+def load_report(path):
+    return json.loads(read(path, REPORT_LIMIT), object_pairs_hook=unique)
+
+
+def unpack(raw):
+    if not isinstance(raw, bytes) or len(raw) < 16 or len(raw) > INPUT_LIMIT or raw[:4] != b'GSC\0':
+        raise ValueError('Expected bounded GSC container')
+    packed, length, code_length = struct.unpack_from('<III', raw, 4)
+    if not packed or not code_length or length > STACK_LIMIT or packed + code_length != len(raw) - 16:
+        raise ValueError('Invalid GSC lengths')
+    inflater = zlib.decompressobj()
+    try:
+        stack = inflater.decompress(raw[16:16 + packed], length + 1)
+    except zlib.error as error:
+        raise ValueError('Invalid zlib stack') from error
+    if len(stack) != length or not inflater.eof or inflater.unused_data or inflater.unconsumed_tail:
+        raise ValueError('Stack is truncated, trailing or overproducing')
+    code = raw[16 + packed:]
+    if code[0] != 0x34:
+        raise ValueError('Missing initial OP_End')
+    return code, stack
+
+
+def load_profile(source_root, expected_sha, expected_tables_sha):
+    """Rehash every source table against the separately pinned reviewed profile."""
+    raw = read(ROOT / 'reference-profile.json', 256 * 1024)
+    if sha(raw) != expected_sha:
+        raise ValueError('Reference profile pin mismatch')
+    profile = json.loads(raw, object_pairs_hook=unique)
+    if (profile['schema'] != 'iw7.gsc-reference-profile/1' or profile['engine'] != 'iw7-pc-server'
+            or profile['features'] != ['str4', 'tok4', 'offs9'] or profile['max_string_id'] != 0x13FCC
+            or profile['table_authority'] != 'community-source-only' or profile['retail_runtime_attested'] is not False
+            or profile['counts'] != {'opcodes': 153, 'functions': 806, 'methods': 1483, 'tokens': 13220}):
+        raise ValueError('Unsupported reference profile')
+    records = profile['table_files']
+    if len(records) != len(TABLE_PATHS) or {r['path'] for r in records} != TABLE_PATHS:
+        raise ValueError('Incomplete table provenance')
+    canonical = json.dumps(records, sort_keys=True, separators=(',', ':')).encode()
+    if sha(canonical) != expected_tables_sha or profile['tables_sha256'] != expected_tables_sha:
+        raise ValueError('Reference/native table digest mismatch')
+    sources = {}
+    source_root = Path(source_root).resolve()
+    for record in records:
+        path = (source_root / record['path']).resolve()
+        if not path.is_relative_to(source_root):
+            raise ValueError('Table source escapes supplied root')
+        content = read(path, 4 * 1024 * 1024)
+        if sha(content) != record['sha256']:
+            raise ValueError('Table source pin mismatch: ' + record['path'])
+        sources[record['path']] = content.decode('utf-8')
+    opcodes = profile['opcodes']
+    native_map = [(int(raw, 16), name) for raw, name in re.findall(
+        r'\{\s*(0x[0-9A-Fa-f]+),\s*opcode::(OP_\w+)\s*\}', sources['src/gsc/engine/iw7_code.cpp'])]
+    if len(opcodes) != 153 or [(r['id'], r['name']) for r in opcodes] != native_map:
+        raise ValueError('Opcode profile does not cover the exact IW7 map')
+    if len({r['id'] for r in opcodes}) != 153 or any(r['kind'] not in KINDS for r in opcodes):
+        raise ValueError('Unknown or duplicate opcode category')
+    for row in opcodes:
+        if row['kind'] == 'unsupported_size':
+            if row['bytes'] is not None:
+                raise ValueError('Unsupported opcode must remain blocked')
+        elif type(row['bytes']) is not int or not 1 <= row['bytes'] <= 13:
+            raise ValueError('Invalid opcode size policy')
+    tables = {}
+    for name, suffix, count in [('functions', 'func', 806), ('methods', 'meth', 1483), ('tokens', 'token', 13220)]:
+        # These exact pinned tables contain simple ASCII literals. No permissive
+        # C++ escape interpretation or guessed name is allowed for future tables.
+        text = sources['src/gsc/engine/iw7_' + suffix + '.cpp']
+        entries = re.findall(r'^\s*\{\s*(0x[0-9A-Fa-f]+),\s*"([^"\\\r\n]*)"\s*\}', text, re.MULTILINE)
+        table = {int(key, 16): value.encode('ascii') for key, value in entries}
+        if len(entries) != count or len(table) != count:
+            raise ValueError('Symbol table is incomplete or ambiguous: ' + name)
+        tables[name] = table
+    return profile, tables
+
+
+class Reader:
+    def __init__(self, raw):
+        self.raw, self.pos = raw, 0
+
+    def u32(self):
+        if self.pos + 4 > len(self.raw):
+            raise ValueError('Truncated stack integer at ' + str(self.pos))
+        value = struct.unpack_from('<I', self.raw, self.pos)[0]
+        self.pos += 4
+        return value
+
+    def string(self):
+        end = self.raw.find(b'\0', self.pos)
+        if end < 0:
+            raise ValueError('Unterminated stack string at ' + str(self.pos))
+        value = self.raw[self.pos:end]
+        self.pos = end + 1
+        return value
+
+
+def displayed(raw):
+    return b'_encstr_' + raw.hex().upper().encode() if raw and raw[0] & 0xC0 == 0x80 else raw
+
+
+def offset24(raw):
+    value = int.from_bytes(raw, 'little')
+    return (value - 0x1000000 if value & 0x800000 else value) >> 1
+
+
+def inspect_bytes(raw, profile, tables):
+    """Independent parse, for comparison with native boundaries. Not attestation.
+
+    Exported for lightweight byte-level controls; Creator must use validate().
+    Every opcode is visited, including unreachable instructions and all switch
+    entries. Literal strings are not guessed to be script imports.
+    """
+    code, stack = unpack(raw)
+    sr, pos, total = Reader(stack), 1, 0
+    policy = {r['id']: r for r in profile['opcodes']}
+    if len(policy) != 153 or any(r['kind'] not in KINDS for r in policy.values()):
+        raise ValueError('Incomplete or unknown opcode policy')
+    functions, spans, references, blockers, categories = [], [], [], [], {}
+
+    def block(cause, at, stack_at, detail):
+        blockers.append({'cause': cause, 'bytecode_offset': at, 'stack_offset': stack_at, 'detail': detail})
+
+    def symbol(raw_name, token_id, kind, at, start):
+        value = displayed(raw_name)
+        resolved = (bool(value) or kind in ('string', 'switch_string')) and not value.startswith(
+            (b'_id_', b'_func_', b'_meth_', b'_encstr_'))
+        try:
+            text = value.decode('utf-8')
+        except UnicodeDecodeError:
+            text, resolved = None, False
+        if not resolved:
+            block('unresolved_' + kind, at, start, {'token_id': token_id, 'name_hex': value.hex()})
+        return {'token_id': token_id, 'name_hex': value.hex(), 'name': text, 'resolved': resolved}
+
+    def stack_symbol(kind, at):
+        start = sr.pos
+        token = sr.u32()
+        value = sr.string() if token == 0 else tables['tokens'].get(token, f'_id_{token:04X}'.encode())
+        return symbol(value, token, kind, at, start)
+
+    while pos < len(code):
+        if len(functions) >= 10000:
+            raise ValueError('Function limit exceeded')
+        begin, stack_begin = pos, sr.pos
+        size = sr.u32()
+        fn = stack_symbol('function_symbol', begin)
+        end = begin + size
+        if not size or end > len(code):
+            raise ValueError('Invalid function extent')
+        insts, branch_targets = [], []
+        while pos < end:
+            total += 1
+            if total > 100000:
+                raise ValueError('Instruction limit exceeded')
+            row = policy.get(code[pos])
+            if row is None:
+                raise ValueError('Unmapped opcode at bytecode offset ' + str(pos))
+            kind, width, ss = row['kind'], row['bytes'], sr.pos
+            if kind == 'unsupported_size':
+                raise ValueError('Decoder has no supported size for ' + row['name'] + ' at ' + str(pos))
+            if type(width) is not int or width < 1 or pos + width > end:
+                raise ValueError('Instruction exceeds function at ' + str(pos))
+            ref = {'kind': kind, 'opcode': row['name'], 'bytecode_offset': pos, 'stack_offset': ss}
+            categories[kind] = categories.get(kind, 0) + 1
+            if kind.startswith('external_'):
+                ref.update(namespace=stack_symbol('external_namespace', pos), target=stack_symbol('external_target', pos))
+                ref['relocation_hex'] = code[pos + 1:pos + 4].hex()
+                if width == 5:
+                    ref['argument_count'] = code[pos + 4]
+                block('external_script_reference', pos, ss, {'namespace': ref['namespace']['name'], 'target': ref['target']['name']})
+                references.append(ref)
+            elif kind.startswith('local_'):
+                ref['target_offset'] = pos + 1 + offset24(code[pos + 1:pos + 4])
+                if width == 5:
+                    ref['argument_count'] = code[pos + 4]
+                references.append(ref)
+            elif kind.startswith('builtin_'):
+                table = 'methods' if 'method' in kind else 'functions'
+                token = int.from_bytes(code[pos + width - 2:pos + width], 'little')
+                prefix = '_meth_' if table == 'methods' else '_func_'
+                value = tables[table].get(token, (prefix + f'{token:04X}').encode())
+                ref['target'] = symbol(value, token, 'native_symbol', pos, ss)
+                if width == 4:
+                    ref['argument_count'] = code[pos + 1]
+                elif not kind.endswith('_address'):
+                    ref['argument_count'] = int(row['name'][-1])
+                references.append(ref)
+            elif kind == 'pointer':
+                if width == 2:
+                    ref['argument_count'] = code[pos + 1]
+                block('dynamic_call_target', pos, ss, row['name'])
+                references.append(ref)
+            elif kind in ('string', 'animtree', 'animation'):
+                values = [symbol(sr.string(), None, kind, pos, ss)]
+                if kind == 'animation':
+                    values.append(symbol(sr.string(), None, kind, pos, sr.pos))
+                if kind != 'string':
+                    ref['symbols'] = values
+                    references.append(ref)
+            elif kind == 'field':
+                token = int.from_bytes(code[pos + 1:pos + 5], 'little')
+                if token <= profile['max_string_id']:
+                    symbol(tables['tokens'].get(token, f'_id_{token:04X}'.encode()), token, 'field', pos, ss)
+                else:
+                    indirect = sr.u32()
+                    if indirect == 0:
+                        symbol(sr.string(), None, 'field', pos, ss)
+                    else:
+                        # Decoder emits a decimal number, not a resolved symbol.
+                        block('unresolved_indirect_field', pos, ss, {'encoded_id': token, 'stack_id': indirect})
+            elif kind == 'branch_i16':
+                branch_targets.append(pos + 3 + int.from_bytes(code[pos + 1:pos + 3], 'little', signed=True))
+            elif kind == 'branch_back_u16':
+                branch_targets.append(pos + 3 - int.from_bytes(code[pos + 1:pos + 3], 'little'))
+            elif kind == 'branch_i32':
+                branch_targets.append(pos + 5 + int.from_bytes(code[pos + 1:pos + 5], 'little', signed=True))
+            elif kind == 'switch':
+                branch_targets.append(pos + 4 + int.from_bytes(code[pos + 1:pos + 5], 'little', signed=True))
+            elif kind == 'switch_table':
+                count = int.from_bytes(code[pos + 1:pos + 3], 'little')
+                width += count * 7
+                if pos + width > end:
+                    raise ValueError('Switch table exceeds function')
+                for entry in range(pos + 3, pos + width, 7):
+                    value = int.from_bytes(code[entry:entry + 4], 'little')
+                    if value < 0x100000:
+                        literal = sr.string()
+                        if value:
+                            symbol(literal, None, 'switch_string', pos, ss)
+                        elif literal != b'\x01':
+                            block('unknown_switch_default_encoding', pos, ss, literal.hex())
+                    branch_targets.append(entry + 4 + offset24(code[entry + 4:entry + 7]))
+            elif kind not in ('plain', 'scalar', 'slot'):
+                raise ValueError('Unimplemented opcode category: ' + kind)
+            insts.append({'bytecode_begin': pos, 'bytecode_bytes': width, 'opcode': code[pos],
+                          'stack_begin': ss, 'stack_end': sr.pos})
+            pos += width
+        boundaries = {inst['bytecode_begin'] for inst in insts}
+        if any(target not in boundaries for target in branch_targets):
+            raise ValueError('Branch target is not an instruction in its function')
+        functions.append({'bytecode_begin': begin, 'token_id': fn['token_id'], 'name_hex': fn['name_hex'], 'instructions': insts})
+        spans.append({'bytecode_begin': begin, 'declared_bytes': size, 'bytecode_end': end,
+                      'stack_begin': stack_begin, 'stack_end': sr.pos})
+    if sr.pos != len(stack):
+        raise ValueError('Unconsumed stack suffix')
+    by_address = {f['bytecode_begin']: f for f in functions}
+    for ref in references:
+        if ref['kind'].startswith('local_'):
+            target = by_address.get(ref['target_offset'])
+            if target is None:
+                raise ValueError('Local script target is not a function entry at ' + str(ref['bytecode_offset']))
+            ref['target_name_hex'] = target['name_hex']
+    return {'functions': functions, 'function_spans': spans, 'references': references, 'blockers': blockers,
+            'instruction_count': total, 'category_counts': categories,
+            'encoded_external_script_reference_absence': not blockers}
+
+
+def exact(actual, expected):
+    """Canonical JSON comparison rejects bool-as-int and extra/missing fields."""
+    return json.dumps(actual, sort_keys=True, separators=(',', ':'), allow_nan=False) == json.dumps(
+        expected, sort_keys=True, separators=(',', ':'), allow_nan=False)
+
+
+def validate(raw, native, pins, source_root, consumption_validator):
+    fields = {'decoder', 'profile_sha256', 'reference_validator_sha256', 'consumption_validator_sha256'}
+    if not isinstance(pins, dict) or set(pins) != fields:
+        raise ValueError('Require independent decoder, profile and both validator pins')
+    for key in fields - {'decoder'}:
+        if not isinstance(pins[key], str) or not re.fullmatch('[0-9a-f]{64}', pins[key]):
+            raise ValueError('Invalid pin: ' + key)
+    if sha(read(__file__, 1024 * 1024)) != pins['reference_validator_sha256']:
+        raise ValueError('Reference validator pin mismatch')
+    if sha(read(consumption_validator.__file__, 1024 * 1024)) != pins['consumption_validator_sha256']:
+        raise ValueError('Consumption validator pin mismatch')
+    if (not isinstance(native, dict) or set(native) != {'schema', 'profile_sha256', 'consumption', 'functions'}
+            or native['schema'] != 'iw7.gsc-reference-native/1' or native['profile_sha256'] != pins['profile_sha256']):
+        raise ValueError('Invalid native reference schema or profile pin')
+    consumption_validator.validate_witness(raw, native['consumption'], pins['decoder'])
+    profile, tables = load_profile(source_root, pins['profile_sha256'], pins['decoder']['tables_sha256'])
+    parsed = inspect_bytes(raw, profile, tables)
+    if not exact(native['functions'], parsed['functions']):
+        raise ValueError('Native instruction/symbol/stack coverage disagrees with independent byte reader')
+    if not exact(native['consumption']['functions'], parsed['function_spans']):
+        raise ValueError('Native function coverage disagrees with independent byte reader')
+    return {'schema': 'iw7.gsc-reference-bound/1', 'scope': 'encoded-script-references-under-pinned-iw7-profile',
+            'input_sha256': sha(raw), 'pins': pins, 'instruction_count': parsed['instruction_count'],
+            'category_counts': parsed['category_counts'], 'references': parsed['references'], 'blockers': parsed['blockers'],
+            'complete_instruction_coverage_verified': True,
+            'encoded_external_script_reference_absence': parsed['encoded_external_script_reference_absence'],
+            'table_authority': 'community-source-only', 'native_execution_authenticated': False,
+            'native_builtin_semantics_verified': False, 'asset_dependency_closure_verified': False,
+            'retail_runtime_compatibility_verified': False, 'runtime_validation_passed': False,
+            'owner_acceptance': False, 'package_ready': False}
