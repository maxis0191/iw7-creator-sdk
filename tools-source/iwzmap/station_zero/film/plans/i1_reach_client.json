{
 "schema": "iw7.gamelab-plan/1",
 "name": "i1_reach_client",
 "map": "cp_iwz",
 "conditions": "quiet",
 "libraries": [
  "szaccept",
  "szi1"
 ],
 "about": "I1: is the Heel & Key marksman buy usable from the hall? A client standing where the hull stops at the stall counter, facing the pegboard: the UI dump and a frame (the buy prompt shows or not).",
 "steps": [
  {
   "do": "waves",
   "on": false
  },
  {
   "do": "call",
   "fn": "sz_power_direct",
   "args": [
    "power",
    20
   ],
   "s": 1
  },
  {
   "do": "wait",
   "s": 6
  },
  {
   "do": "doors"
  },
  {
   "do": "money",
   "value": 20000
  },
  {
   "do": "tp",
   "at": [
    -1420,
    4284,
    1
   ],
   "yaw": 90
  },
  {
   "do": "look",
   "yaw": 90,
   "pitch": 10
  },
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "call",
   "fn": "i1_stand",
   "args": [
    "hk_stop"
   ],
   "s": 1
  },
  {
   "do": "ui",
   "name": "hk_prompt"
  },
  {
   "do": "capture",
   "name": "i1_hk_prompt",
   "pause": 2
  },
  {
   "do": "tp",
   "at": [
    -1880,
    4420,
    1
   ],
   "yaw": 180,
   "snap": true
  },
  {
   "do": "look",
   "yaw": 180,
   "pitch": 10
  },
  {
   "do": "wait",
   "s": 2
  },
  {
   "do": "ui",
   "name": "smg_prompt"
  },
  {
   "do": "capture",
   "name": "i1_smg_prompt",
   "pause": 2
  },
  {
   "do": "expect",
   "that": "probe:hk_stop.ground",
   "eq": 1,
   "why": "standing at the counter"
  }
 ]
}