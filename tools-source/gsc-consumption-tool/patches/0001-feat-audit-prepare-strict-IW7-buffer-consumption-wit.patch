+    message(FATAL_ERROR "This audited target currently requires Windows/MSVC and BCrypt")
+endif()
+if(NOT EXISTS "${AUDIT_IDENTITY_DIR}/audit_identity.hpp")
+    message(FATAL_ERROR "Run audit/prepare.py from a clean committed checkout first")
+endif()
+set(CMAKE_CXX_STANDARD 20)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
+set(ROOT "${CMAKE_CURRENT_SOURCE_DIR}/..")
+file(GLOB GSC_SOURCES CONFIGURE_DEPENDS "${ROOT}/src/gsc/*.cpp" "${ROOT}/src/gsc/common/*.cpp"
+    "${ROOT}/src/gsc/engine/iw7*.cpp")
+file(GLOB UTILS_SOURCES CONFIGURE_DEPENDS "${ROOT}/src/utils/*.cpp")
+file(GLOB ZLIB_SOURCES CONFIGURE_DEPENDS "${ROOT}/deps/zlib/*.c")
+if(NOT EXISTS "${ROOT}/deps/zlib/zlib.h")
+    message(FATAL_ERROR "Pinned zlib source is required; initialization is an admitted preparation step")
+endif()
+add_library(audit_zlib STATIC ${ZLIB_SOURCES})
+target_include_directories(audit_zlib PUBLIC "${ROOT}/deps/zlib")
+target_compile_definitions(audit_zlib PRIVATE _CRT_SECURE_NO_WARNINGS)
+add_library(audit_gsc STATIC ${GSC_SOURCES} ${UTILS_SOURCES})
+target_include_directories(audit_gsc PUBLIC "${ROOT}/include")
+target_link_libraries(audit_gsc PUBLIC audit_zlib)
+target_compile_options(audit_gsc PRIVATE /bigobj /Zc:__cplusplus)
+add_executable(iw7-gsc-audit main.cpp)
+target_include_directories(iw7-gsc-audit PRIVATE "${AUDIT_IDENTITY_DIR}")
+target_compile_definitions(iw7-gsc-audit PRIVATE _WIN32_WINNT=0x0A00)
+target_link_libraries(iw7-gsc-audit PRIVATE audit_gsc bcrypt)
+enable_testing()
+add_executable(audit-reader-tests reader_tests.cpp)
+target_link_libraries(audit-reader-tests PRIVATE audit_gsc)
+add_test(NAME strict-reader COMMAND audit-reader-tests)
